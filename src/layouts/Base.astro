---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import AboutBoot from '../components/AboutBoot.astro'
import Boot from '../components/Boot.astro'
import { site } from '../data/site'
// above-the-fold Poppins weights, preloaded so text never swaps (no layout shift)
import f500 from '@fontsource/poppins/files/poppins-latin-500-normal.woff2?url'
import f600 from '@fontsource/poppins/files/poppins-latin-600-normal.woff2?url'
import f700 from '@fontsource/poppins/files/poppins-latin-700-normal.woff2?url'

import type { NavLink } from '../components/Nav.astro'
interface Props { title?: string; description?: string; nav?: NavLink[]; page?: string; theme?: 'sport' }
const { title = `${site.name} | Data & Software Engineer`, description = site.tagline, nav, page, theme } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbfcff" />
    <!-- light-only design: opt out of browsers' forced/auto dark mode (Samsung Internet, Chrome) -->
    <meta name="color-scheme" content="only light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" />
    {[f500, f600, f700].map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- loaders only on the first landing: skip them once the session has booted or when arriving from another page of this site -->
    <script is:inline>(function(){var s=false,i=false;try{s=!!sessionStorage.getItem('booted')}catch(e){}try{i=!!document.referrer&&new URL(document.referrer).origin===location.origin}catch(e){}
window.__skipBoot=s||i;if(window.__skipBoot)document.documentElement.classList.add('booted')
// a prerendered page waits until it is actually shown before its intro plays
window.__bootDone=function(){function d(){window.__booted=true;document.dispatchEvent(new Event('boot:done'))}document.prerendering?document.addEventListener('prerenderingchange',d,{once:true}):d()}})()</script>
    <!-- instant page switches: Chromium prerenders the next page (About right away, other links on hover), so clicking just swaps it in -->
    <script is:inline type="speculationrules" set:html={JSON.stringify({ prerender: [
      ...(Astro.url.pathname.startsWith('/about') ? [] : [{ source: 'list', urls: ['/about/'], eagerness: 'immediate' }]),
      { where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/about/' } }] }, eagerness: 'moderate' }
    ] })} />
    <noscript><style>#aboot{display:none}</style></noscript>
    <noscript><style>#boot{display:none}[data-reveal]{opacity:1!important;transform:none!important}</style></noscript>
  </head>
  <body>
    {theme === 'sport' ? <AboutBoot /> : <Boot />}
    <Nav links={nav} page={page} theme={theme} />
    <main><slot /></main>
    <Footer />
    <script>
      // reveal once on scroll
      const io = new IntersectionObserver((entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target) }
      }), { rootMargin: '0px 0px -8% 0px' })
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el))
    </script>
  </body>
</html>
