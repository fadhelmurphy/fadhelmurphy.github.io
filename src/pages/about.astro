---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import track from '../assets/about/track.jpg'
import jobs from '../assets/about/film-jobs.webp'
import ford from '../assets/about/film-ford.webp'
import spidey from '../assets/about/film-spiderman.webp'
import interstellar from '../assets/about/film-interstellar.webp'
import gtasa from '../assets/about/game-gtasa.webp'
import gta5 from '../assets/about/game-gta5.webp'
import jc4 from '../assets/about/game-jc4.webp'
import hmns from '../assets/about/perfume-hmns.webp'
import esteh from '../assets/about/perfume-esteh.webp'
import dappers from '../assets/about/perfume-dappers.webp'

const games = [
  { t: 'GTA: San Andreas', why: 'for its nostalgic charm and timeless exploration.', img: gtasa, r: -7, x: '0%', y: '26%', z: 3 },
  { t: 'GTA V', why: 'for its dynamic world and thrilling adventures.', img: gta5, r: 5, x: '42%', y: '0%', z: 1 },
  { t: 'Just Cause 4', why: 'for its chaotic action and stress-free fun.', img: jc4, r: -3, x: '40%', y: '56%', z: 2 }
]
const films = [
  { t: 'Jobs', meta: 'Biopic, 2013', img: jobs },
  { t: 'Ford v Ferrari', meta: 'Drama, 2019', img: ford },
  { t: 'Spider-Man: No Way Home', meta: 'Superhero, 2021', img: spidey },
  { t: 'Interstellar', meta: 'Sci-fi, 2014', img: interstellar }
]
const music = [
  { mood: 'Pop-punk that takes me back to my teens', bands: ['Blink-182', 'Neck Deep'] },
  { mood: 'Metal riffs for energy', bands: ['Slayer', 'Napalm Death'] },
  { mood: 'Softer songs for winding down', bands: ['Taylor Swift', 'LANY'] }
]
const perfumes = [
  { t: 'HMNS', n: 'Darker Shade of Orgasm', img: hmns, r: -10 },
  { t: 'Es Teh Manis', n: 'Eau de parfum', img: esteh, r: 0 },
  { t: 'Dappers', n: 'Teh Melati', img: dappers, r: 10 }
]
const strava = 'https://strava.app.link/E63xhR6AR7b'
const runGear = [
  { k: 'Watch', t: 'Garmin Forerunner 165', n: 'Every lap, every heartbeat' },
  { k: 'Long runs & tempo', t: 'ASICS Superblast 3', n: 'The everything shoe' },
  { k: 'Daily miles', t: 'adidas Adizero Boston 13', n: 'Workouts with some bite' },
  { k: 'Trail', t: 'ASICS Novablast 5 TR', n: 'When the road runs out' },
  { k: 'Also in the bag', t: 'Camp SR3D', n: '' }
]
const nav = [
  { href: '#running', label: 'Running', id: 'running', note: 'Laps on the track', icon: 'M13 4a2 2 0 1 0 0 .01M7 21l3-6 3 2v4M10 15l1-5 4 3 3-1M8 9l3-2', track: true },
  { href: '#cycling', label: 'Cycling', id: 'cycling', note: 'Road and MTB', icon: 'M5.5 17.5a3.5 3.5 0 1 0 0-.01M18.5 17.5a3.5 3.5 0 1 0 0-.01M5.5 17.5L9 9h6l3.5 8.5M9 9l3 8.5 3-8.5M8 6h3', track: true },
  { href: '#games', label: 'Games', id: 'games', note: 'Frequently played', icon: 'M6 11h4M8 9v4M15 12h.01M18 10h.01M5 7h14a3 3 0 0 1 3 3v4a3 3 0 0 1-5.2 2L15 14H9l-1.8 2A3 3 0 0 1 2 14v-4a3 3 0 0 1 3-3z', track: true },
  { href: '#films', label: 'Films', id: 'films', note: 'Top picks', icon: 'M4 5h16v14H4zM8 5v14M16 5v14M4 9h4M4 15h4M16 9h4M16 15h4', track: true },
  { href: '#music', label: 'Music', id: 'music', note: 'On repeat', icon: 'M9 18V6l11-2v12M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM20 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0z', track: true },
  { href: '#perfume', label: 'Perfume', id: 'perfume', note: 'Wearing lately', icon: 'M9 3h6v3H9zM7 8h10v12H7z', track: true },
  { href: '#gear', label: 'Gear', id: 'gear', note: 'What I play on', icon: 'M3 5h18v11H3zM8 20h8M12 16v4', track: true },
  { href: '/', label: 'Home', id: 'home', note: 'Back to the main page', icon: 'M4 11l8-7 8 7v9H4z' }
]
const rig = ['Ryzen 9 5900X', '30GB DDR4 Corsair', 'RTX 2060 Super', 'ASRock X570 Taichi', '1TB SSD, 1TB HDD', 'Cooler Master 240L V2', 'Windows 11']
const desk = ['MSI Optix G241 144Hz', 'AIRO AIO24X 165Hz', 'Nemesis 1080p webcam', 'Rexus Daxa M71', 'Logitech G203', 'Panasonic TV']
---
<Base nav={nav} page="About" title="About | Fadhel Ijlal Falah" description="Fadhel Ijlal Falah off the clock: running, cycling, games, films, music and gear.">
<canvas id="morph" class="pointer-events-none fixed inset-0 z-0 h-full w-full" aria-hidden="true"></canvas>
<div class="about relative z-10">

  <section data-shape="0" data-x="0.45" class="relative flex min-h-[100svh] items-start px-6 pt-32 md:items-center md:px-12 md:pt-0">
    <div class="mx-auto w-full max-w-6xl">
      <p class="in text-sm font-semibold text-blue-600">Off the clock</p>
      <h1 class="in title-xl mt-4">Hi, I'm<br /><span class="grad">Fadhel.</span></h1>
      <p class="in mt-6 max-w-md text-lg leading-relaxed text-slate" style="animation-delay:.15s">I run, I ride, and I still play the games I grew up with. This is the part of me that isn't on a CV.</p>
      <p class="in mt-8 flex items-center gap-2 text-sm text-slate" style="animation-delay:.3s"><span class="size-2 rounded-full bg-emerald-500"></span>Tangerang, Indonesia</p>
    </div>
  </section>

  <section id="running" data-shape="1" data-x="0.5" class="scroll-mt-16 px-6 py-28 md:px-12 md:py-40">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-xl">
        <p data-reveal class="kicker">Running</p>
        <h2 data-reveal class="title">Laps on the <span class="grad">track.</span></h2>
        <p data-reveal class="lede">Track sessions, long runs, and the occasional ultra.</p>
      </div>
      <figure data-reveal class="glass mt-14 overflow-hidden rounded-[32px] p-2">
        <Image src={track} alt="Fadhel leading a group run on a stadium track at night" width={1600} widths={[800, 1200, 1600]} sizes="(min-width: 1280px) 1150px, 92vw" class="aspect-[4/5] w-full rounded-[26px] object-cover object-[50%_60%] md:aspect-[16/9]" loading="lazy" />
      </figure>
    </div>
  </section>

  <section id="run-gear" data-shape="4" data-x="-0.5" class="px-6 py-28 md:px-12 md:py-36">
    <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-2">
      <div class="hidden md:block"></div>
      <div>
        <p data-reveal class="kicker">Running kit</p>
        <h2 data-reveal class="title">What I run <span class="grad">in.</span></h2>
        <ul class="mt-10 space-y-3">
          {runGear.map((g, i) => (
            <li data-reveal class="glass gear flex items-center justify-between gap-4 rounded-2xl px-5 py-4" style={`transition-delay:${i * 70}ms`}>
              <div><p class="text-xs font-medium text-slate">{g.k}</p><p class="mt-0.5 text-lg font-semibold tracking-tight text-navy">{g.t}</p></div>
              {g.n && <p class="text-right text-sm text-slate">{g.n}</p>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="cycling" data-shape="2" data-x="0.5" class="scroll-mt-16 px-6 py-28 md:px-12 md:py-40">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-lg">
        <p data-reveal class="kicker">Cycling</p>
        <h2 data-reveal class="title">Road and <span class="grad">dirt.</span></h2>
        <p data-reveal class="lede">When the legs need a break from running, I ride, on the road or on the MTB trails. Every run and ride ends up on Strava.</p>
        <a data-reveal href={strava} target="_blank" rel="noopener" class="strava mt-10 inline-flex items-center gap-3 rounded-full px-7 py-4 font-semibold text-white">
          Follow me on Strava
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
        </a>
      </div>
    </div>
  </section>

  <section id="games" data-shape="3" data-x="-0.5" class="scroll-mt-16 px-6 py-28 md:px-12 md:py-36">
    <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-2">
      <div class="hidden md:block"></div>
      <div>
        <p data-reveal class="kicker">Games</p>
        <h2 data-reveal class="title">Frequently <span class="grad">played.</span></h2>
        <ul class="mt-10 grid grid-cols-3 gap-3">
          {games.map((g, i) => (
            <li data-reveal class="glass rounded-2xl p-1.5" style={`transition-delay:${i * 80}ms`}>
              <Image src={g.img} alt={`${g.t} cover art`} width={300} widths={[200, 300]} sizes="(min-width: 768px) 180px, 30vw" class="aspect-square w-full rounded-xl object-cover" loading="lazy" />
              <p class="px-1 pt-2 pb-1 text-xs font-semibold text-navy">{g.t}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="films" data-shape="3" data-x="0.5" class="scroll-mt-16 px-6 py-28 md:px-12 md:py-36">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-lg">
        <p data-reveal class="kicker">Films</p>
        <h2 data-reveal class="title">Top <span class="grad">picks.</span></h2>
        <p data-reveal class="lede">Mostly people who build things. And one about space.</p>
      </div>
      <ul class="no-bar -mx-6 mt-12 flex snap-x gap-4 overflow-x-auto px-6 pb-2 md:mx-0 md:grid md:max-w-3xl md:grid-cols-4 md:px-0">
        {films.map((f, i) => (
          <li data-reveal class="glass w-[40vw] shrink-0 snap-start rounded-2xl p-1.5 md:w-auto" style={`transition-delay:${i * 80}ms`}>
            <Image src={f.img} alt={`${f.t} poster`} width={260} widths={[200, 260]} sizes="(min-width: 768px) 180px, 40vw" class="aspect-[3/4] w-full rounded-xl object-cover object-top" loading="lazy" />
            <p class="px-1 pt-2 text-sm leading-snug font-semibold text-navy">{f.t}</p><p class="px-1 pb-1 text-xs text-slate">{f.meta}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="music" data-shape="0" data-x="0.6" class="scroll-mt-16 px-6 py-28 md:px-12 md:py-40">
    <div class="mx-auto max-w-6xl text-center">
      <p data-reveal class="kicker">Music</p>
      <h2 data-reveal class="title">On <span class="grad">repeat.</span></h2>
      <div class="mt-14 space-y-8">
        {music.map((m) => (
          <div data-reveal>
            <p class="text-sm font-medium text-slate">{m.mood}</p>
            <p class="mt-1 text-[clamp(2rem,6vw,4.5rem)] leading-none font-bold tracking-[-0.04em] text-navy">{m.bands.join(' / ')}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="perfume" data-shape="3" data-x="-0.5" class="scroll-mt-16 px-6 py-28 md:px-12 md:py-36">
    <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-2">
      <div class="hidden md:block"></div>
      <div>
        <p data-reveal class="kicker">Perfume</p>
        <h2 data-reveal class="title">Wearing <span class="grad">lately.</span></h2>
        <ul class="mt-10 grid grid-cols-3 gap-3">
          {perfumes.map((p, i) => (
            <li data-reveal class="glass rounded-2xl p-1.5 text-center" style={`transition-delay:${i * 80}ms`}>
              <div class="rounded-xl bg-white"><Image src={p.img} alt={`${p.t} perfume bottle`} width={180} class="aspect-[4/5] w-full object-contain p-3" loading="lazy" /></div>
              <p class="pt-2 text-sm font-semibold text-navy">{p.t}</p><p class="pb-1 text-[11px] leading-tight text-slate">{p.n}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="gear" data-shape="4" data-x="0.5" class="scroll-mt-16 px-6 py-28 md:px-12 md:py-40">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-xl">
        <p data-reveal class="kicker">Desk</p>
        <h2 data-reveal class="title">What I play <span class="grad">on.</span></h2>
        <p data-reveal class="mt-8 text-[clamp(2rem,4.5vw,3.5rem)] leading-none font-bold tracking-[-0.03em] text-navy">MacBook Pro M2</p>
        <p data-reveal class="mt-3 text-lg font-semibold text-navy">Samsung S21 FE, iPhone 15</p>
        <div data-reveal class="mt-10 grid grid-cols-2 gap-6 text-sm">
          <div><p class="font-medium text-slate">Desktop</p><ul class="mt-2 space-y-1.5 text-navy">{rig.map((r) => <li>{r}</li>)}</ul></div>
          <div><p class="font-medium text-slate">Desk</p><ul class="mt-2 space-y-1.5 text-navy">{desk.map((r) => <li>{r}</li>)}</ul></div>
        </div>
      </div>
    </div>
  </section>
</div>
</Base>

<script>
  import { mountMorph } from '../scripts/particle-morph'
  const c = document.getElementById('morph') as HTMLCanvasElement | null
  const secs = [...document.querySelectorAll<HTMLElement>('[data-shape]')]
  if (c) {
    const go = () => mountMorph(c, secs)
    ;'requestIdleCallback' in window ? (window as any).requestIdleCallback(go, { timeout: 1500 }) : setTimeout(go, 600)
  }
</script>

<style>
  :global(body:has(.about)) { background: radial-gradient(70% 50% at 80% 10%, #eaf3ff 0%, transparent 70%), radial-gradient(60% 50% at 10% 60%, #e8fbf3 0%, transparent 70%), #fbfcff; background-attachment: fixed; }
  .title-xl { font-size: clamp(3.4rem, 10vw, 8.5rem); line-height: .92; font-weight: 700; letter-spacing: -0.05em; color: var(--color-navy); }
  .title { margin-top: .75rem; font-size: clamp(2.6rem, 6.5vw, 5rem); line-height: .98; font-weight: 700; letter-spacing: -0.04em; color: var(--color-navy); }
  .kicker { font-size: .875rem; font-weight: 600; color: #2563eb; }
  .lede { margin-top: 1.25rem; font-size: 1.125rem; line-height: 1.65; color: var(--color-slate); }
  .grad { background: linear-gradient(100deg, #2563eb, #0ea5e9 50%, #10b981); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .glass { background: rgb(255 255 255 / .62); border: 1px solid rgb(255 255 255 / .95); box-shadow: 0 20px 50px -30px rgb(37 99 235 / .35); backdrop-filter: blur(18px) saturate(160%); -webkit-backdrop-filter: blur(18px) saturate(160%); }
  .gear { transition: transform .5s cubic-bezier(.34,1.56,.64,1), opacity .9s ease; }
  .gear:hover { transform: translateX(6px); }
  .strava { background: #fc4c02; box-shadow: 0 16px 40px -16px rgb(252 76 2 / .7); transition: transform .4s cubic-bezier(.34,1.56,.64,1); }
  .strava:hover { transform: translateY(-2px) scale(1.02); }
  .in { animation: rise 1.1s cubic-bezier(.16,1,.3,1) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(32px); } }
  .no-bar { scrollbar-width: none; } .no-bar::-webkit-scrollbar { display: none; }
  @media (prefers-reduced-motion: reduce) { .in { animation: none; } }
</style>
