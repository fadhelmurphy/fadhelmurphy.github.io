---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import track from '../assets/about/track.jpg'

const strava = 'https://strava.app.link/E63xhR6AR7b'
const runGear = [
  { k: 'Watch', t: 'Garmin Forerunner 165' },
  { k: 'Shoes', t: 'ASICS Superblast 3' },
  { k: 'Shoes', t: 'adidas Adizero Boston 13' },
  { k: 'Trail shoes', t: 'ASICS Novablast 5 TR' },
  { k: 'Also', t: 'Camp SR3D' }
]
const nav = [
  { href: '#run', label: 'Run', id: 'run', note: 'Laps on the track', icon: 'M13 4a2 2 0 1 0 0 .01M7 21l3-6 3 2v4M10 15l1-5 4 3 3-1M8 9l3-2', track: true },
  { href: '#ride', label: 'Ride', id: 'ride', note: 'Road and MTB', icon: 'M5.5 17.5a3.5 3.5 0 1 0 0-.01M18.5 17.5a3.5 3.5 0 1 0 0-.01M5.5 17.5L9 9h6l3.5 8.5M9 9l3 8.5 3-8.5M8 6h3', track: true },
  { href: '#strava', label: 'Strava', id: 'strava', note: 'Follow the activity', icon: 'M15 3l-5 10h4l1-2 3 6h3L15 3zM9 13l-4 8h4l2-4', track: true },
  { href: '/', label: 'Home', id: 'home', note: 'Back to the main page', icon: 'M4 11l8-7 8 7v9H4z' }
]
---
<Base nav={nav} page="About" title="About | Fadhel Ijlal Falah" description="Fadhel Ijlal Falah off the clock: running and riding, tracked on Strava.">
<div class="sport">
  <!-- one pinned stage; the whole story plays as you scroll through this tall section -->
  <section class="story relative" style="height:720vh">
    <span id="run" class="anchor" style="top:22%;height:20%"></span>
    <span id="ride" class="anchor" style="top:42%;height:18%"></span>
    <span id="strava" class="anchor" style="top:60%;height:40%"></span>
    <div id="stage" class="sticky top-0 h-[100svh] overflow-hidden">
      <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
      <canvas id="map" class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
      <canvas id="gl3d" class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
      <div class="absolute inset-x-0 bottom-0 h-[3px] bg-slate-200/70"><div data-bar class="h-full origin-left scale-x-0 bg-gradient-to-r from-[#4f46e5] via-[#0891b2] to-[#16a34a]"></div></div>

      <div class="relative z-10 mx-auto h-full max-w-6xl px-6 md:px-12">
        <div data-from="-1" data-to="0.19" class="blk">
          <p class="kicker">Off the clock</p>
          <h1 class="big mt-4">Run.<br />Ride.<br /><span class="grad">Repeat.</span></h1>
          <p class="mt-6 max-w-sm text-lg leading-relaxed text-slate">What keeps the heart going when I'm not at a desk. Keep scrolling.</p>
        </div>

        <div data-from="0.22" data-to="0.4" class="blk">
          <p class="kicker">Run</p>
          <h2 class="title">Laps on <span class="grad">the track.</span></h2>
          <ul class="mt-7 max-w-md divide-y divide-slate-200/80 border-y border-slate-200/80">
            {runGear.map((g) => <li class="flex items-baseline justify-between gap-4 py-3"><span class="text-sm text-slate">{g.k}</span><span class="text-right font-semibold text-navy">{g.t}</span></li>)}
          </ul>
        </div>

        <div data-from="0.42" data-to="0.58" class="blk">
          <p class="kicker">Ride</p>
          <h2 class="title">Road and <span class="grad">dirt.</span></h2>
          <p class="lede max-w-sm">When the legs need a break from running, I ride: long road loops, or the MTB on the trails.</p>
        </div>

        <div data-from="0.62" data-to="0.94" class="blk blk-top">
          <p class="kicker !text-[#fc4c02]">Strava</p>
          <h2 class="title">Tracking the <span class="grad">activity</span>,<br />keep scrolling.</h2>
        </div>

        <div data-from="0.95" data-to="2" class="blk blk-top">
          <h2 class="title">Activity <span class="grad">complete.</span></h2>
          <p class="lede max-w-sm">Every run and ride ends up here.</p>
          <a href={strava} target="_blank" rel="noopener" class="strava mt-8 inline-flex items-center gap-3 rounded-full px-8 py-4 text-lg font-semibold text-white">
            Follow me on Strava
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-24 md:px-8">
    <figure data-reveal class="glass mx-auto max-w-6xl overflow-hidden rounded-[32px] p-2">
      <Image src={track} alt="Fadhel leading a group run on a stadium track at night" width={1600} widths={[800, 1200, 1600]} sizes="(min-width: 1280px) 1150px, 92vw" class="aspect-[4/5] w-full rounded-[26px] object-cover object-[50%_60%] md:aspect-[16/9]" loading="lazy" />
    </figure>
  </section>
</div>
</Base>

<script>
  import { mountStory } from '../scripts/story'
  const stage = document.getElementById('stage')
  const a = document.getElementById('gl3d') as HTMLCanvasElement | null, b = document.getElementById('map') as HTMLCanvasElement | null
  if (stage && a && b) mountStory(stage, a, b)
</script>

<style>
  :global(body:has(.sport)) { background: #f7fafc; }
      .sport { color: var(--color-navy); }
  .aurora { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .aurora i { position: absolute; border-radius: 50%; filter: blur(80px); opacity: .7; animation: drift 18s ease-in-out infinite alternate; }
  .aurora i:nth-child(1) { width: 60vmax; height: 40vmax; left: -15vmax; top: -18vmax; background: radial-gradient(closest-side, #bbf7d0, transparent); }
  .aurora i:nth-child(2) { width: 55vmax; height: 40vmax; right: -18vmax; bottom: -20vmax; background: radial-gradient(closest-side, #c7d2fe, transparent); animation-duration: 24s; }
  .aurora i:nth-child(3) { width: 40vmax; height: 30vmax; right: 10vmax; top: -15vmax; background: radial-gradient(closest-side, #a5f3fc, transparent); animation-duration: 21s; opacity: .5; }
  @keyframes drift { to { transform: translate(6vmax, 4vmax) scale(1.12); } }
  .anchor { position: absolute; left: 0; width: 1px; pointer-events: none; }
  .blk { position: absolute; left: 1.5rem; right: 1.5rem; top: 50%; translate: 0 -50%; opacity: 0; will-change: opacity, transform; }
  @media (min-width: 768px) { .blk { left: 3rem; right: auto; max-width: 34rem; } }
  @media (max-width: 767px) { .blk { top: 6.5rem; translate: none; } }
  .blk-top { top: 7rem; translate: none; }
  @media (min-width: 768px) { .blk-top { top: 8rem; } }
  .blk:first-child { opacity: 1; }
  .big { font-size: clamp(3.4rem, 9.5vw, 8rem); line-height: .95; font-weight: 300; letter-spacing: -0.045em; color: var(--color-navy); }
  .title { margin-top: .75rem; font-size: clamp(2.4rem, 5.5vw, 4.5rem); line-height: 1; font-weight: 300; letter-spacing: -0.04em; color: var(--color-navy); }
  .kicker { font-size: .75rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: #0891b2; }
  .lede { margin-top: 1.25rem; font-size: 1.0625rem; line-height: 1.65; color: var(--color-slate); }
  .grad { background: linear-gradient(100deg, #16a34a, #0891b2 50%, #4f46e5); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .glass { background: rgb(255 255 255 / .7); border: 1px solid rgb(255 255 255 / .95); box-shadow: 0 24px 60px -36px rgb(8 145 178 / .45); }
  .strava { background: #fc4c02; box-shadow: 0 18px 40px -16px rgb(252 76 2 / .7); transition: transform .4s cubic-bezier(.34,1.56,.64,1); }
  .strava:hover { transform: translateY(-2px) scale(1.03); }
  @media (prefers-reduced-motion: reduce) { .aurora i { animation: none; } }
</style>
