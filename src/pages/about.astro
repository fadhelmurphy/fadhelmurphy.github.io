---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import track from '../assets/about/track.jpg'
import jobs from '../assets/about/film-jobs.webp'
import ford from '../assets/about/film-ford.webp'
import spidey from '../assets/about/film-spiderman.webp'
import interstellar from '../assets/about/film-interstellar.webp'
import gtasa from '../assets/about/game-gtasa.webp'
import gta5 from '../assets/about/game-gta5.webp'
import jc4 from '../assets/about/game-jc4.webp'
import pc from '../assets/about/gear-pc.webp'
import hmns from '../assets/about/perfume-hmns.webp'
import esteh from '../assets/about/perfume-esteh.webp'
import dappers from '../assets/about/perfume-dappers.webp'

const games = [
  { t: 'GTA: San Andreas', why: 'for its nostalgic charm and timeless exploration.', img: gtasa, r: -7, x: '0%', y: '26%', z: 3 },
  { t: 'GTA V', why: 'for its dynamic world and thrilling adventures.', img: gta5, r: 5, x: '42%', y: '0%', z: 1 },
  { t: 'Just Cause 4', why: 'for its chaotic action and stress-free fun.', img: jc4, r: -3, x: '40%', y: '56%', z: 2 }
]
const films = [
  { t: 'Jobs', meta: 'Biopic, 2013', img: jobs },
  { t: 'Ford v Ferrari', meta: 'Drama, 2019', img: ford },
  { t: 'Spider-Man: No Way Home', meta: 'Superhero, 2021', img: spidey },
  { t: 'Interstellar', meta: 'Sci-fi, 2014', img: interstellar }
]
const music = [
  { mood: 'Pop-punk that takes me back to my teens', bands: ['Blink-182', 'Neck Deep'] },
  { mood: 'Metal riffs for energy', bands: ['Slayer', 'Napalm Death'] },
  { mood: 'Softer songs for winding down', bands: ['Taylor Swift', 'LANY'] }
]
const perfumes = [
  { t: 'HMNS', n: 'Darker Shade of Orgasm', img: hmns, r: -10 },
  { t: 'Es Teh Manis', n: 'Eau de parfum', img: esteh, r: 0 },
  { t: 'Dappers', n: 'Teh Melati', img: dappers, r: 10 }
]
const rig = ['Ryzen 9 5900X', '30GB DDR4 Corsair', 'RTX 2060 Super', 'ASRock X570 Taichi', '1TB SSD, 1TB HDD', 'Cooler Master 240L V2', 'Windows 11']
const desk = ['MSI Optix G241 144Hz', 'AIRO AIO24X 165Hz', 'Nemesis 1080p webcam', 'Rexus Daxa M71', 'Logitech G203', 'Panasonic TV']
---
<Base title="About | Fadhel Ijlal Falah" description="Fadhel Ijlal Falah, off the clock: running, games, films, music, perfume and gear.">
<div class="space">
  <div class="nebula n1"></div><div class="nebula n2"></div><div class="nebula n3"></div><div class="nebula n4"></div><div class="nebula n5"></div>
  <!-- hero: holographic planet with a running track in orbit -->
  <section class="relative isolate min-h-[100svh] overflow-hidden">
    <canvas id="orbit" class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
    <div class="pointer-events-none relative z-10 mx-auto flex min-h-[100svh] max-w-6xl flex-col justify-start px-6 pt-32 md:justify-center md:px-12 md:pt-0">
      <p class="ab-in text-sm font-medium tracking-wide text-violet-600">Off the clock</p>
      <h1 class="ab-in headline mt-4 max-w-[12ch]">Hi, I'm <span class="holo-text">Fadhel.</span></h1>
      <p class="ab-in mt-6 max-w-md text-lg leading-relaxed text-slate" style="animation-delay:.15s">I run laps, play the games I grew up with, keep pop-punk and metal on repeat, and have opinions about perfume.</p>
      <p class="ab-in mt-8 flex items-center gap-2 text-sm text-slate" style="animation-delay:.3s"><span class="size-2 rounded-full bg-emerald-400 shadow-[0_0_10px_#34d399]"></span>Tangerang, Indonesia</p>
    </div>
    
  </section>

  <!-- running -->
  <section class="px-4 pb-28 md:px-8">
    <figure data-reveal class="holo-border relative mx-auto max-w-7xl overflow-hidden rounded-[36px]">
      <Image src={track} alt="Fadhel leading a group run on a stadium track at night" width={1600} widths={[800, 1200, 1600]} sizes="(min-width: 1280px) 1248px, 96vw" class="aspect-[4/5] w-full object-cover object-[50%_60%] md:aspect-[16/9]" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-t from-[#1e1b4b]/85 via-[#1e1b4b]/10 to-transparent"></div>
      <figcaption class="absolute inset-x-0 bottom-0 p-7 md:p-12">
        <p class="text-sm font-medium text-cyan-300">Running</p>
        <p class="mt-2 max-w-2xl text-4xl leading-[1.02] font-bold tracking-[-0.03em] text-white md:text-6xl">Laps on the track, <span class="holo-light">one after another.</span></p>
      </figcaption>
    </figure>
  </section>

  <!-- games -->
  <section class="chapter">
    <div class="mx-auto grid max-w-6xl items-center gap-14 md:grid-cols-2">
      <div>
        <h2 data-reveal class="title">Frequently <span class="holo-text">played</span></h2>
        <p data-reveal class="lede">Gaming is how I relax after a busy day.</p>
        <ul data-reveal class="mt-6 space-y-3 text-slate">
          {games.map((g) => <li><b class="font-semibold text-navy">{g.t}</b> {g.why}</li>)}
        </ul>
      </div>
      <div class="relative mx-auto aspect-square w-full max-w-[520px]">
        <div class="orbit-rings" aria-hidden="true"></div>
        {games.map((g, i) => (
          <figure data-reveal class="tilt card3d absolute w-[56%]" style={`--r:${g.r}deg;left:${g.x};top:${g.y};z-index:${g.z};transition-delay:${i * 90}ms`}>
            <Image src={g.img} alt={`${g.t} cover art`} width={460} widths={[320, 460]} sizes="(min-width: 768px) 300px, 55vw" class="aspect-[4/3] w-full rounded-[14px] object-cover" loading="lazy" />
            <figcaption class="pt-2.5 text-center text-sm font-semibold text-navy">{g.t}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- films -->
  <section class="chapter">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <h2 data-reveal class="title">Top picks <span class="holo-text">in films</span></h2>
        <p data-reveal class="lede max-w-sm md:text-right">Mostly stories about people who build things. And one about space.</p>
      </div>
      <ul class="no-bar -mx-6 mt-12 flex snap-x snap-mandatory scroll-px-6 gap-4 overflow-x-auto px-6 pb-4 md:mx-0 md:grid md:grid-cols-4 md:overflow-visible md:px-0">
        {films.map((f, i) => (
          <li data-reveal class="poster w-[46vw] shrink-0 snap-start md:w-auto" style={`transition-delay:${i * 80}ms`}>
            <div class="holo-border overflow-hidden rounded-[18px]"><Image src={f.img} alt={`${f.t} poster`} width={300} widths={[240, 300]} sizes="(min-width: 768px) 270px, 46vw" class="aspect-[3/4] w-full object-cover object-top" loading="lazy" /></div>
            <p class="mt-4 leading-snug font-semibold text-navy">{f.t}</p>
            <p class="text-sm text-slate">{f.meta}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- music -->
  <section class="chapter">
    <div class="mx-auto max-w-6xl">
      <h2 data-reveal class="title text-center">On <span class="holo-text">repeat</span></h2>
      <p data-reveal class="lede mx-auto max-w-md text-center">Music has always been my escape and my inspiration.</p>
      <div class="mt-14 space-y-10">
        {music.map((m, i) => (
          <div data-reveal class:list={['flex flex-col gap-2', i % 2 ? 'items-end text-right' : 'items-start']}>
            <p class="text-sm font-medium text-slate">{m.mood}</p>
            <p class="text-[clamp(2.4rem,7vw,5.5rem)] leading-none font-bold tracking-[-0.04em]">
              {m.bands.map((b, k) => <>{k > 0 && <span class="text-slate-300"> / </span>}<span class="holo-text">{b}</span></>)}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- perfume -->
  <section class="chapter">
    <div class="mx-auto grid max-w-6xl items-center gap-14 md:grid-cols-2">
      <div class="order-2 flex justify-center md:order-1">
        {perfumes.map((p, i) => (
          <figure data-reveal class="tilt card3d relative -mx-2 w-[36%] max-w-[200px]" style={`--r:${p.r}deg;z-index:${i === 1 ? 3 : 1};transition-delay:${i * 90}ms;margin-top:${i === 1 ? 0 : 2.5}rem`}>
            <div class="rounded-[14px] bg-white"><Image src={p.img} alt={`${p.t} perfume bottle`} width={180} class="aspect-[4/5] w-full object-contain p-3" loading="lazy" /></div>
            <figcaption class="px-1 pt-2 text-center"><p class="text-sm font-semibold text-navy">{p.t}</p><p class="text-[11px] leading-tight text-slate">{p.n}</p></figcaption>
          </figure>
        ))}
      </div>
      <div class="order-1 md:order-2">
        <h2 data-reveal class="title">Wearing <span class="holo-text">lately</span></h2>
        <p data-reveal class="lede">Scent is a quiet way to show personality. These three cover a laid-back day out and a more formal evening.</p>
      </div>
    </div>
  </section>

  <!-- gear -->
  <section class="chapter pb-32">
    <div class="mx-auto max-w-6xl">
      <h2 data-reveal class="title">Gear</h2>
      <p data-reveal class="lede">What I play, and tinker, on.</p>
      <div class="mt-12 grid gap-10 md:grid-cols-[1.1fr_0.9fr]">
        <div data-reveal class="holo-border overflow-hidden rounded-[24px]"><Image src={pc} alt="Inside the desktop PC, lit purple" width={640} widths={[400, 640]} sizes="(min-width: 768px) 560px, 90vw" class="aspect-[4/3] w-full object-cover" loading="lazy" /></div>
        <div class="flex flex-col justify-between gap-10">
          <div data-reveal>
            <p class="text-sm font-medium text-slate">Laptop</p>
            <p class="mt-1 text-[clamp(2.4rem,5vw,3.75rem)] leading-none font-bold tracking-[-0.03em] text-navy">MacBook Pro M2</p>
            <p class="mt-3 text-sm font-medium text-slate">Phones</p>
            <p class="mt-1 text-2xl font-semibold tracking-tight text-navy">Samsung S21 FE, iPhone 15</p>
          </div>
          <div data-reveal class="grid grid-cols-2 gap-6 text-sm">
            <div><p class="font-medium text-slate">Desktop</p><ul class="mt-2 space-y-1.5 text-navy">{rig.map((r) => <li>{r}</li>)}</ul></div>
            <div><p class="font-medium text-slate">Desk</p><ul class="mt-2 space-y-1.5 text-navy">{desk.map((r) => <li>{r}</li>)}</ul></div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
</Base>

<script>
  import { mountOrbit } from '../scripts/orbit-scene'
  const c = document.getElementById('orbit') as HTMLCanvasElement | null
  if (c) mountOrbit(c)
  // holographic sheen + 3D tilt that follow the pointer
  document.querySelectorAll<HTMLElement>('.card3d').forEach((el) => {
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect(), x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height
      el.style.setProperty('--mx', x * 100 + '%'); el.style.setProperty('--my', y * 100 + '%')
      el.style.transform = `perspective(700px) rotateX(${(0.5 - y) * 14}deg) rotateY(${(x - 0.5) * 18}deg) scale(1.05)`
    })
    el.addEventListener('pointerleave', () => { el.style.transform = '' })
  })
</script>

<style>
  .space { position: relative; isolation: isolate; overflow-x: clip; background: #f8faff; color: var(--color-navy); }
  .nebula { position: absolute; z-index: -1; border-radius: 50%; opacity: .6; animation: drift 22s ease-in-out infinite alternate; pointer-events: none; will-change: transform; }
  .n1 { width: 55vmax; height: 55vmax; left: -15vmax; top: -10vmax; background: radial-gradient(circle, #c7d2fe, transparent 70%); }
  .n2 { width: 45vmax; height: 45vmax; right: -12vmax; top: 20vmax; background: radial-gradient(circle, #fbcfe8, transparent 70%); animation-duration: 28s; }
  .n3 { width: 50vmax; height: 50vmax; left: 20vmax; top: 90vmax; background: radial-gradient(circle, #a5f3fc, transparent 70%); animation-duration: 26s; }
  .n4 { width: 45vmax; height: 45vmax; right: -10vmax; top: 170vmax; background: radial-gradient(circle, #bbf7d0, transparent 70%); animation-duration: 30s; }
  .n5 { width: 50vmax; height: 50vmax; left: -15vmax; top: 250vmax; background: radial-gradient(circle, #ddd6fe, transparent 70%); }
  @keyframes drift { to { transform: translate(6vmax, -4vmax) scale(1.15) rotate(20deg); } }
      .headline { font-size: clamp(3.2rem, 9vw, 7.5rem); line-height: .95; font-weight: 700; letter-spacing: -0.045em; color: var(--color-navy); }
  .ab-in { animation: rise 1.1s cubic-bezier(.16,1,.3,1) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(32px); } }
  .chapter { padding: 6rem 1.5rem; }
  @media (min-width: 768px) { .chapter { padding: 8rem 3rem; } }
  .title { font-size: clamp(2.8rem, 7vw, 5.5rem); line-height: .98; font-weight: 700; letter-spacing: -0.04em; color: var(--color-navy); }
  .lede { margin-top: 1.25rem; font-size: 1.125rem; line-height: 1.65; color: var(--color-slate); }
  /* holographic foil text: shifting iridescent gradient */
  .holo-text { background: linear-gradient(100deg, #2563eb, #7c3aed 22%, #db2777 42%, #0891b2 64%, #059669 82%, #2563eb); background-size: 250% 100%;
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; animation: holo 8s linear infinite; }
  @keyframes holo { to { background-position: 250% 0; } }
  /* iridescent hairline border */
  .holo-border { position: relative; }
  .holo-border::after { content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1px; pointer-events: none;
    background: conic-gradient(from var(--a, 0deg), #60a5fa, #a78bfa, #f472b6, #facc15, #34d399, #60a5fa);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; opacity: .7; animation: spin 6s linear infinite; }
  @property --a { syntax: "<angle>"; inherits: false; initial-value: 0deg; }
  @keyframes spin { to { --a: 360deg; } }
  /* 3D cards that tilt in space and straighten on hover */
  .card3d { padding: .55rem .55rem .7rem; border-radius: 22px; background: rgb(255 255 255 / .7); border: 1px solid rgb(255 255 255 / .95);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 30px 60px -24px rgb(79 70 229 / .35), 0 0 0 1px rgb(199 210 254 / .5);
    transform: perspective(900px) rotateY(calc(var(--r, 0deg) * 1.6)) rotate(var(--r, 0deg)); }
  [data-reveal].card3d { transform: translateY(24px) perspective(900px) rotateY(calc(var(--r, 0deg) * 1.6)) rotate(var(--r, 0deg)); }
  [data-reveal].card3d.in { transform: perspective(900px) rotateY(calc(var(--r, 0deg) * 1.6)) rotate(var(--r, 0deg)); }
  .card3d::before { content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; opacity: 0; transition: opacity .3s;
    background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgb(255 255 255 / .7), transparent 40%), linear-gradient(115deg, transparent 20%, rgb(96 165 250 / .35) 35%, rgb(244 114 182 / .35) 50%, rgb(250 204 21 / .3) 62%, transparent 80%);
    background-size: 100% 100%, 250% 250%; background-position: 0 0, var(--mx, 50%) var(--my, 50%); mix-blend-mode: soft-light; z-index: 2; }
  .card3d:hover::before { opacity: 1; }
  .holo-light { background: linear-gradient(100deg, #a5f3fc, #c4b5fd 30%, #fbcfe8 55%, #fde68a 75%, #a5f3fc); background-size: 250% 100%; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; animation: holo 8s linear infinite; }
  .tilt { transition: transform .7s cubic-bezier(.34,1.56,.64,1), opacity .9s ease; }
  .tilt:hover { transform: perspective(900px) rotateY(0) rotate(0) scale(1.05) !important; z-index: 10 !important; }
  .orbit-rings { position: absolute; inset: 2%; border-radius: 50%; transform: rotateX(70deg); border: 1px solid rgb(124 58 237 / .25);
    box-shadow: 0 0 0 30px rgb(167 139 250 / .04), 0 0 0 31px rgb(167 139 250 / .2), 0 0 0 70px rgb(103 232 249 / .03), 0 0 0 71px rgb(103 232 249 / .15); animation: ring 14s linear infinite; }
  @keyframes ring { to { transform: rotateX(70deg) rotateZ(360deg); } }
  .poster img { transition: transform .7s cubic-bezier(.16,1,.3,1); }
  .poster:hover img { transform: scale(1.04); }
  .no-bar { scrollbar-width: none; } .no-bar::-webkit-scrollbar { display: none; }
  @media (prefers-reduced-motion: reduce) { .nebula, .ab-in, .holo-text, .holo-border::after, .orbit-rings, .tilt, .poster img { animation: none; transition: none; } }
</style>
