---
import { Image } from 'astro:assets'
import '@fontsource-variable/archivo/wdth.css'
import Base from '../layouts/Base.astro'
import runner from '../assets/about/runner.jpg'
import runnerBlur from '../assets/about/runner-blur.jpg'
import { longRun, recent, month, gear, stream, syncedAt } from '../data/strava'
import mRace from '../assets/about/moments/race.jpg'
import mNight from '../assets/about/moments/night-road.jpg'
import mMorning from '../assets/about/moments/morning.jpg'
import mFriends from '../assets/about/moments/friends.jpg'
import mTrail from '../assets/about/moments/trail.jpg'
import mCity from '../assets/about/moments/city.jpg'
import mTrack from '../assets/about/moments/track.jpg'

const strava = 'https://strava.app.link/E63xhR6AR7b'
const sd = new Date(syncedAt)
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
const synced = `${sd.getUTCDate()} ${MON[sd.getUTCMonth()]}`

// heart rate across the long run, drawn into a 1000×260 box
const W = 1000, H = 260
const { km } = stream
// light smoothing so the line reads as a trend, not noise
const hr = stream.hr.map((_, i, a) => { const w = a.slice(Math.max(0, i - 4), i + 5); return w.reduce((x, y) => x + y, 0) / w.length })
const has = hr.length > 1
const kmMax = has ? km[km.length - 1] : 1
const lo = has ? Math.min(...hr) - 6 : 0, hi = has ? Math.max(...hr) + 4 : 1
const line = has ? hr.map((b, i) => `${i ? 'L' : 'M'}${((km[i] / kmMax) * W).toFixed(1)} ${(H - ((b - lo) / (hi - lo)) * H).toFixed(1)}`).join(' ') : ''
const area = has ? `${line} L${W} ${H} L0 ${H} Z` : ''
const ticks = [0, 10, 20, 30, 40].filter((t) => t <= kmMax)
const spark = has ? stream.hr.map((b, i) => `${i ? 'L' : 'M'}${((i / (stream.hr.length - 1)) * 200).toFixed(1)} ${(40 - ((b - lo) / (hi - lo)) * 40).toFixed(1)}`).join(' ') : ''

const moments = [
  { src: mRace, alt: 'Fadhel raising three fingers to the camera mid-race, bib M 43954', cap: 'Race day' },
  { src: mNight, alt: 'A runner seen from behind on a dark road, lit by a headlamp', cap: 'Night road, headlamp on' },
  { src: mMorning, alt: 'Fadhel running past trees on a sunny morning', cap: 'Morning miles' },
  { src: mFriends, alt: 'Fadhel running with two friends between city towers at night', cap: 'With the crew' },
  { src: mTrail, alt: 'Fadhel running a gravel trail in sandals with a hydration vest', cap: 'Trail, in sandals' },
  { src: mCity, alt: 'Fadhel running along a city street at night', cap: 'City laps' },
  { src: mTrack, alt: 'Fadhel leading a group on a stadium track at night', cap: 'Track night' }
]

const statement = 'By day I build data pipelines. Most nights I run, usually long and usually in the dark. On rest days I ride.'

const nav = [
  { href: '#run', label: 'Run', id: 'run', note: 'Who, and how much', icon: 'M13 4a2 2 0 1 0 0 .01M7 21l3-6 3 2v4M10 15l1-5 4 3 3-1M8 9l3-2', track: true },
  { href: '#replay', label: 'Long run', id: 'replay', note: 'The longest run this month', icon: 'M3 12h4l2-5 4 10 2-5h6', track: true },
  { href: '#gear', label: 'Gear', id: 'gear', note: 'Shoes, watch and bike', icon: 'M3 16l6-2 4 2 8 1v2H3zM9 14l1-5 3 1', track: true },
  { href: '#strava', label: 'Strava', id: 'strava', note: 'Follow the activity', icon: 'M15 3l-5 10h4l1-2 3 6h3L15 3zM9 13l-4 8h4l2-4', track: true },
  { href: '/', label: 'Home', id: 'home', note: 'Back to the main page', icon: 'M4 11l8-7 8 7v9H4z' }
]
---
<Base nav={nav} page="About" theme="sport" title="About | Fadhel Ijlal Falah" description="Fadhel Ijlal Falah off the clock: running and riding, synced from Strava.">
<main class="ab">

  <!-- 1 · HERO (pin 1 of 2) -->
  <section id="run" class="hero" data-hero>
    <div class="h-stage">
      <div class="h-photo" aria-hidden="true" data-gl-src={runner.src}>
        <Image src={runnerBlur} alt="" widths={[900]} sizes="100vw" loading="eager" fetchpriority="high" class="ph" />
        <Image src={runner} alt="" widths={[640, 1100]} sizes="100vw" loading="eager" class="ph sharp" />
        <div class="h-shade"></div>
      </div>
      <div class="h-grid" aria-hidden="true"><i></i><i></i><i></i></div>

      <div class="h-in">
        <p class="h-intro" data-fade>I run most nights and ride when the legs need a break. This page pulls from Strava, so the numbers stay current.</p>

        <aside class="h-card" data-fade aria-label="Longest run in the last 30 days">
          <p class="hc-k">Longest run, last 30 days</p>
          <p class="hc-v">{longRun.km}<small>km</small></p>
          {has && <svg viewBox="0 0 200 40" preserveAspectRatio="none" class="hc-spark" aria-hidden="true"><path d={spark} /></svg>}
          <dl class="hc-s">
            <div><dt>Pace</dt><dd>{longRun.movingPace}<small>/km</small></dd></div>
            <div><dt>Moving</dt><dd>{longRun.moving}</dd></div>
            <div><dt>Energy</dt><dd>{longRun.cal}<small>cal</small></dd></div>
          </dl>
        </aside>

        <table class="h-runs" data-fade>
          <caption>Recent runs</caption>
          <thead><tr><th scope="col">Date</th><th scope="col">Km</th><th scope="col">Time</th><th scope="col">Pace</th></tr></thead>
          <tbody>{recent.map((r) => <tr><td>{r.date}</td><td>{r.km}</td><td>{r.time}</td><td>{r.pace}</td></tr>)}</tbody>
        </table>

        <div class="h-month" data-fade>
          <p><b>{month.km}</b> km</p>
          <p>{month.runs} runs in the last 30 days</p>
        </div>

        <h1 class="h-word" aria-label="Run. Ride. Repeat.">
          <span class="hw-run" data-split>Run.</span>
          <span class="hw-sub" data-fade aria-hidden="true"><em>Ride.</em> Repeat.</span>
        </h1>
      </div>
    </div>
  </section>

  <!-- 2b · horizontal photo strip: swipe / shift-scroll / arrows; the page keeps scrolling normally -->
  <section class="moments" aria-labelledby="mo-title">
   <div class="mo-stage">
    <header class="mo-head">
      <h2 id="mo-title" class="disp mo-title" data-split>Out there</h2>
      <p class="mo-note">Mostly at night, sometimes in sandals.</p>
      <div class="mo-nav">
        <button type="button" class="mo-btn" data-mo-prev aria-label="Previous photos"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
        <button type="button" class="mo-btn" data-mo-next aria-label="Next photos"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
      </div>
    </header>
    <div class="mo-strip" data-mo-strip tabindex="0" role="region" aria-label="Running photos, scroll sideways">
      <ul class="mo-track" data-mo>
        {moments.map((m, i) => (
          <li class={`mo-item ${i % 2 ? 'low' : ''}`}>
            <figure>
              <div class="mo-frame"><Image src={m.src} alt={m.alt} widths={[360, 640]} sizes="(min-width: 900px) 30vh, 60vw" class="mo-img" /></div>
              <figcaption><span>{String(i + 1).padStart(2, '0')}</span>{m.cap}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
    <div class="mo-bar" aria-hidden="true"><i data-mo-bar></i></div>
   </div>
  </section>

  <!-- 5 · THE LONG RUN: scroll-driven flyover (stylised route, not GPS) -->
  <section id="replay" class="fly" data-fly>
    <div class="fl-stage">
      <div class="fl-panel" data-fly-host>
        <header class="fl-hud">
          <p class="fl-k">The long run</p>
          <p class="fl-date">{longRun.date}</p>
          <dl class="fl-stats" aria-hidden="true">
            <div><dt>Pace</dt><dd><b data-f="pace">–</b><small>/km</small></dd></div>
            <div><dt>Heart rate</dt><dd><b data-f="hr">–</b><small>bpm</small></dd></div>
            <div><dt>Distance</dt><dd><b data-f="km">0.0</b><small>km</small></dd></div>
          </dl>
        </header>
        <p class="fl-note">Route drawn for illustration · numbers from Strava</p>
      </div>
    </div>
  </section>
  <section class="wrap fl-after" aria-label="Long run summary">
    <dl class="l-sum">
      <div><dt>Total time</dt><dd>{longRun.time}</dd></div>
      <div><dt>Avg heart rate</dt><dd>{longRun.avgHr} bpm</dd></div>
      <div><dt>Elevation</dt><dd>{longRun.elev} m</dd></div>
    </dl>
  </section>

  <!-- 6 · GEAR -->
  <section id="gear" class="gear wrap" aria-labelledby="g-title">
    <h2 id="g-title" class="sec-t" data-up>Gear I trust</h2>
    <ul class="g-grid">
      {gear.map((g, i) => (
        <li class="card g-card" data-card>
          <span class="g-n">{String(i + 1).padStart(2, '0')}</span>
          <p class="c-k">{g.k}</p>
          <p class="g-name">{g.t}</p>
          <p class="g-m">{g.m}</p>
        </li>
      ))}
    </ul>
    <p class="g-note">The kilometres are what Strava has logged on each pair.</p>
  </section>

  <!-- 7 · CTA -->
  <section id="strava" class="cta wrap">
    <div class="cta-panel" data-cta>
      <p class="cta-t">Step out of comfort.<br /><span>Stay in the fight.</span></p>
      <a href={strava} target="_blank" rel="noopener" class="pill dark">
        Follow on Strava
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
      </a>
    </div>
  </section>
  <script type="application/json" id="run-stream" set:html={JSON.stringify({ km: stream.km, hr: stream.hr, v: stream.v, kmMax })} />
</main>

<style>
  .ab { --bg: #f2f1ec; --card: #ffffff; --ink: #111214; --mute: #6b6d73; --line: rgb(17 18 20 / .1); --or: #fc4c02; --ease: cubic-bezier(.16, 1, .3, 1); --pad: clamp(16px, 3.4vw, 48px);
    background: var(--bg); color: var(--ink); overflow-x: clip; font-family: 'Poppins', sans-serif; }
  .wrap { max-width: 1320px; margin-inline: auto; padding-inline: var(--pad); }
  .disp, .h-word, .sec-t, .n-v, .cta-t, .g-name { font-family: 'Archivo Variable', sans-serif; }

  /* shared bits */
  .card { background: var(--card); border-radius: 0; padding: clamp(22px, 2.4vw, 34px); }
  .c-k { font-size: 13px; color: var(--mute); }
  .c-note { margin-top: 8px; font-size: 15px; color: var(--mute); }
  .sec-k { font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--mute); margin-bottom: 20px; }
  .sec-t { font-size: clamp(40px, 6vw, 88px); font-weight: 800; font-stretch: 100%; letter-spacing: -.045em; line-height: .95; }
  .pill { display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 10px 0 24px; border-radius: 0; font-size: 15px; font-weight: 600; cursor: pointer; transition: transform .3s var(--ease), background-color .2s; }
  .pill svg { width: 32px; height: 32px; padding: 8px; border-radius: 0; fill: none; stroke: currentColor; stroke-width: 2; transition: transform .3s var(--ease); }
  .pill.dark { background: var(--ink); color: #fff; }
  .pill.dark svg { background: var(--or); color: #fff; }
  .pill:hover { transform: translateY(-2px); }
  .pill:hover svg { transform: rotate(45deg); }
  .pill:focus-visible, .round:focus-visible, .p-strip:focus-visible { outline: 3px solid var(--or); outline-offset: 3px; }

  /* ── hero (live version) ── */
  .h-word { font-family: 'Archivo Variable', sans-serif; font-stretch: 125%; font-weight: 800; text-transform: uppercase; letter-spacing: -.035em; line-height: .86; }
  .hero { position: relative; height: 200vh; }
  .h-stage { position: sticky; top: 0; height: 100svh; overflow: hidden; color: #fff; }
  .h-photo { position: absolute; inset: 0; will-change: transform; }
  .ph { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .sharp { --m: radial-gradient(ellipse 16% 34% at 41% 32%, #000 55%, rgb(0 0 0 / .55) 78%, transparent 100%); -webkit-mask-image: var(--m); mask-image: var(--m); }
  @media (max-width: 900px) { .sharp { --m: radial-gradient(ellipse 34% 20% at 45% 33%, #000 55%, rgb(0 0 0 / .55) 78%, transparent 100%); } }
  :global(.h-gl) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; opacity: 0; transition: opacity .9s ease; }
  :global(.h-gl.on) { opacity: 1; }
  /* corner scrims: top-left behind the intro, bottom-left behind the headline, a warm Strava glow at the bottom right */
  .h-intro, .h-card, .h-runs, .h-month { filter: opacity(calc(1 - var(--out, 0))); }
  .h-shade { position: absolute; inset: 0; z-index: 2; pointer-events: none; background:
    radial-gradient(ellipse 55% 45% at 0% 0%, rgb(14 14 18 / .62), rgb(14 14 18 / .25) 45%, transparent 75%),
    radial-gradient(ellipse 75% 60% at 0% 100%, rgb(14 14 18 / .72), rgb(14 14 18 / .3) 50%, transparent 80%),
    radial-gradient(ellipse 50% 45% at 100% 100%, rgb(252 76 2 / .5), rgb(252 76 2 / .16) 45%, transparent 75%),
    linear-gradient(180deg, transparent 60%, rgb(14 14 18 / .25)); }
  .h-grid { position: absolute; inset: 0 clamp(20px, 4vw, 56px); display: grid; grid-template-columns: repeat(4, 1fr); pointer-events: none; }
  .h-grid i { border-left: 1px solid rgb(255 255 255 / .14); }
  .h-grid i:last-child { border-right: 1px solid rgb(255 255 255 / .14); }
  .h-in { position: relative; height: 100%; padding: 104px clamp(20px, 4vw, 56px) 0; display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: auto 1fr auto; column-gap: 0; }
  .h-intro { grid-column: 1 / 2; font-size: 15px; line-height: 1.5; padding-right: 20px; max-width: 30ch; }
  .h-card { grid-column: 4; grid-row: 1 / 3; align-self: start; justify-self: end; width: 100%; max-width: 300px; padding: 16px 18px; background: rgb(255 255 255 / .14); border: 1px solid rgb(255 255 255 / .35); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
  .hc-k { font-size: 12px; opacity: .85; }
  .hc-v { font-size: 40px; font-weight: 750; font-stretch: 110%; letter-spacing: -.03em; line-height: 1.05; margin-top: 2px; }
  .hc-v small, .hc-s small { font-size: .42em; font-weight: 500; margin-left: 3px; opacity: .85; }
  .hc-spark { width: 100%; height: 40px; margin: 10px 0; }
  .hc-spark path { fill: none; stroke: var(--or); stroke-width: 2; vector-effect: non-scaling-stroke; }
  .hc-s { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgb(255 255 255 / .3); padding-top: 10px; }
  .hc-s dt { font-size: 11px; opacity: .8; }
  .hc-s dd { font-size: 15px; font-weight: 650; font-variant-numeric: tabular-nums; }
  .h-runs { grid-column: 3; grid-row: 2; align-self: start; margin: 24px 20px 0 20px; border-collapse: collapse; font-size: 12.5px; font-variant-numeric: tabular-nums; }
  .h-runs caption { text-align: left; font-size: 12px; opacity: .8; padding-bottom: 6px; }
  .h-runs th { text-align: left; font-weight: 500; opacity: .6; padding: 4px 10px 4px 0; border-bottom: 1px solid rgb(255 255 255 / .3); }
  .h-runs td { padding: 6px 10px 6px 0; border-bottom: 1px solid rgb(255 255 255 / .14); }
  .h-runs tbody tr:nth-child(n+4) { opacity: .55; }
  .h-month { grid-column: 4; grid-row: 2; align-self: end; justify-self: end; text-align: right; padding-bottom: 24px; }
  .h-month b { font-size: 44px; font-weight: 750; font-stretch: 110%; letter-spacing: -.03em; }
  .h-month p + p { font-size: 13px; opacity: .85; }
  .h-word { grid-column: 1 / -1; grid-row: 3; margin-left: -.04em; padding-bottom: 2vh; }
  .hw-run { display: block; font-size: clamp(110px, 27vw, 420px); line-height: .78; white-space: nowrap; }
  .hw-sub { display: block; font-size: clamp(22px, 3.2vw, 46px); margin: 10px 0 0 .3vw; }
  .hw-sub em { font-style: normal; color: var(--or); }

  /* ── statement ── */
  .statement { padding-block: clamp(90px, 18vh, 200px) clamp(70px, 14vh, 160px); }
  .st-k { font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--or); margin-bottom: 24px; }
  .st-text { font-family: 'Archivo Variable', sans-serif; font-size: clamp(30px, 4.6vw, 72px); font-weight: 700; letter-spacing: -.035em; line-height: 1.08; max-width: 20ch; }
  .st-text span { opacity: .14; }

  /* ── moments (live version) ── */
  .mo-title { font-family: 'Archivo Variable', sans-serif; font-stretch: 125%; font-weight: 800; text-transform: uppercase; letter-spacing: -.035em; line-height: .86; }
  /* ── moments ── */
  .moments { padding: clamp(70px, 12vh, 140px) 0 clamp(50px, 8vh, 100px); border-bottom: 1px solid var(--line); }
  .mo-stage { display: block; }
  .mo-head { display: flex; align-items: end; gap: 24px; padding: 0 clamp(20px, 4vw, 56px); }
  .mo-title { font-size: clamp(40px, 6vw, 96px); margin-right: auto; }
  .mo-note { font-size: 16px; color: var(--mute); padding-bottom: .4em; }
  .mo-nav { display: flex; gap: 8px; padding-bottom: .2em; }
  .mo-btn { width: 48px; height: 48px; display: grid; place-items: center; border: 1px solid var(--ink); background: transparent; color: var(--ink); cursor: pointer; transition: background-color .2s, color .2s, opacity .2s; }
  .mo-btn:hover:not(:disabled) { background: var(--ink); color: #fff; }
  .mo-btn:disabled { opacity: .3; cursor: default; }
  .mo-btn:focus-visible, .mo-strip:focus-visible { outline: 3px solid var(--or); outline-offset: 3px; }
  .mo-btn svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; }
  .mo-strip { margin-top: clamp(24px, 5vh, 50px); overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-inline: clamp(20px, 4vw, 56px); scrollbar-width: none; cursor: grab; }
  .mo-strip::-webkit-scrollbar { display: none; }
  .mo-strip.drag { cursor: grabbing; scroll-snap-type: none; }
  .mo-track { display: flex; gap: clamp(14px, 2vw, 28px); width: max-content; padding: 0 clamp(20px, 4vw, 56px); }
  .mo-item { width: clamp(240px, 26vw, 400px); flex: none; scroll-snap-align: start; }
  .mo-item.low { margin-top: clamp(24px, 6vh, 70px); }
  .mo-frame { aspect-ratio: 3 / 4; overflow: hidden; background: #d9d8d3; }
  .mo-img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.12); pointer-events: none; user-select: none; -webkit-user-drag: none; }
  .mo-item figcaption { display: flex; gap: 12px; align-items: baseline; padding-top: 10px; border-top: 1px solid var(--ink); margin-top: 10px; font-size: 14px; font-weight: 600; }
  .mo-item figcaption span { color: var(--or); font-variant-numeric: tabular-nums; font-weight: 700; }
  .mo-bar { margin: clamp(18px, 3vh, 30px) clamp(20px, 4vw, 56px) 0; height: 2px; background: var(--line); }
  .mo-bar i { display: block; height: 100%; width: 100%; background: var(--or); transform-origin: 0 50%; transform: scaleX(0); transition: transform .15s linear; }

  /* ── long run flyover ── */
  .fly { position: relative; height: 420vh; }
  .fl-stage { position: sticky; top: 0; height: 100svh; }
  .fl-panel { position: relative; height: 100%; border-radius: 0; overflow: hidden; color: #fff;
    background: linear-gradient(180deg, #1c2c48 0%, #3d5778 28%, #8ea3b8 46%, #b9c2c6 56%, #8b8f7f 70%, #4c5442 100%); }
  .fl-panel::after { content: ''; position: absolute; inset: 0 0 auto; height: 46%; z-index: 1; pointer-events: none; background: linear-gradient(180deg, rgb(16 24 40 / .55), rgb(16 24 40 / .18) 60%, transparent); }
  :global(.route-gl) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; opacity: 0; transition: opacity 1s ease; }
  :global(.route-gl.on) { opacity: 1; }
  .fl-hud { position: absolute; top: clamp(70px, 10vh, 100px); left: 0; right: 0; text-align: center; z-index: 2; text-shadow: 0 2px 16px rgb(0 0 0 / .35); }
  .fl-k { font-family: 'Archivo Variable', sans-serif; font-size: clamp(22px, 2.4vw, 34px); font-weight: 800; letter-spacing: -.02em; text-transform: uppercase; }
  .fl-date { font-size: 13px; opacity: .85; margin-top: 2px; }
  .fl-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: 640px; margin: 18px auto 0; padding: 0 20px; }
  .fl-stats dt { font-size: 12px; opacity: .8; }
  .fl-stats dd { margin-top: 2px; }
  .fl-stats b { font-family: 'Archivo Variable', sans-serif; font-size: clamp(34px, 4.4vw, 64px); font-weight: 800; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
  .fl-stats small { display: block; font-size: 12px; opacity: .8; }
  .fl-note { position: absolute; right: 20px; bottom: 16px; z-index: 2; font-size: 11px; opacity: .7; }
  .fl-after { padding-block: 20px clamp(70px, 12vh, 140px); }
  .l-sum { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .l-sum div { background: var(--card); border-radius: 0; padding: 14px 16px; }
  .l-sum dt { font-size: 12px; color: var(--mute); }
  .l-sum dd { font-size: clamp(16px, 1.4vw, 20px); font-weight: 600; margin-top: 4px; font-variant-numeric: tabular-nums; }

  /* ── gear ── */
  .gear { padding-bottom: clamp(70px, 12vh, 140px); }
  .g-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin-top: 32px; }
  .g-card { display: flex; flex-direction: column; min-height: 220px; transition: transform .4s var(--ease), box-shadow .4s var(--ease); }
  .g-card:hover { transform: translateY(-6px); box-shadow: 0 30px 50px -30px rgb(17 18 20 / .3); }
  .g-n { font-size: 13px; font-weight: 600; color: var(--or); margin-bottom: auto; }
  .g-card .c-k { margin-top: 28px; }
  .g-name { font-size: clamp(22px, 1.9vw, 28px); font-weight: 750; letter-spacing: -.03em; line-height: 1.1; margin-top: 6px; }
  .g-m { align-self: start; margin-top: 16px; font-size: 13px; font-weight: 600; padding: 6px 12px; border-radius: 0; background: #fff0e8; color: #c23a00; font-variant-numeric: tabular-nums; }
  .g-note { margin-top: 16px; font-size: 14px; color: var(--mute); }

  /* ── cta ── */
  .cta { padding-bottom: 10px; }
  .cta-panel { border-radius: 0; padding: clamp(60px, 12vh, 140px) clamp(24px, 5vw, 80px); background: linear-gradient(160deg, #ff7a33, #fc4c02 60%, #e84300); display: flex; flex-direction: column; align-items: start; gap: 40px; will-change: transform; }
  .cta-t { font-size: clamp(44px, 7.4vw, 128px); font-weight: 800; letter-spacing: -.05em; line-height: .92; }
  .cta-t span { color: #fff4ec; }

  @media (max-width: 900px) {
    .h-in { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto 1fr auto; padding-top: 92px; }
    .h-grid { grid-template-columns: repeat(2, 1fr); }
    .h-intro, .h-card, .h-month, .h-word { grid-column: 1; }
    .h-intro { font-size: 14px; }
    .h-card { grid-row: 4; justify-self: stretch; width: auto; max-width: none; min-width: 0; margin-bottom: 20px; padding: 14px; }
    .hc-spark { display: none; }
    .h-runs { display: none; }
    .h-month { grid-row: 2; justify-self: start; text-align: left; padding: 14px 0 0; }
    .h-month b { font-size: 32px; }
    .h-word { grid-row: 3; align-self: end; }
    .hw-run { font-size: 31vw; }
    .hw-sub { font-size: 7vw; margin-bottom: 14px; }
    .mo-head { flex-direction: column; align-items: start; }
    .mo-item { width: 70vw; }
    .mo-nav { display: none; }
    .fl-stats { padding: 0 8px; }
    .l-sum { grid-template-columns: repeat(3, 1fr); }
    .g-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
    .g-card { min-height: 0; padding: 18px; border-radius: 0; }
    .g-card .c-k { margin-top: 18px; }
    .g-name { font-size: 18px; }
  }
  /* ── soft theme (Bevel-inspired): same orange tone, gradients + rounded everywhere, gentler type ── */
  .ab { --bg: #f6f1ec; --r: 32px;
    background:
      radial-gradient(ellipse 70% 40% at 10% 0%, #ffe2cf 0%, transparent 60%),
      radial-gradient(ellipse 60% 40% at 100% 35%, #e9ecfb 0%, transparent 60%),
      radial-gradient(ellipse 70% 40% at 0% 75%, #ffe7da 0%, transparent 60%),
      radial-gradient(ellipse 60% 35% at 100% 100%, #ffd9c2 0%, transparent 60%),
      #f6f1ec; }
  .hero { padding: 10px 10px 0; }
  .h-stage { top: 10px; height: calc(100svh - 20px); border-radius: var(--r); isolation: isolate; }
  .h-grid { display: none; }
  .h-shade { background:
    linear-gradient(180deg, rgb(18 18 28 / .45) 0%, transparent 30%),
    radial-gradient(ellipse 80% 60% at 0% 100%, rgb(18 18 28 / .7), transparent 75%),
    radial-gradient(ellipse 70% 60% at 100% 100%, rgb(252 76 2 / .62), rgb(255 138 76 / .25) 45%, transparent 80%),
    radial-gradient(ellipse 50% 40% at 100% 0%, rgb(255 154 98 / .25), transparent 70%); }
  .h-card { border-radius: 24px; background: linear-gradient(150deg, rgb(255 255 255 / .24), rgb(255 255 255 / .08)); }
  .h-runs { border-collapse: separate; border-spacing: 0; padding: 12px 16px 6px; border-radius: 22px; background: linear-gradient(150deg, rgb(255 255 255 / .16), rgb(255 255 255 / .05)); border: 1px solid rgb(255 255 255 / .22); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .h-runs tr:last-child td { border-bottom: 0; }
  .h-word { font-stretch: 100%; text-transform: none; letter-spacing: -.06em; }
  .hw-run { line-height: .82; }
  .hw-sub { letter-spacing: -.03em; }

  .mo-title { font-stretch: 100%; text-transform: none; letter-spacing: -.05em; line-height: .95; }
  .mo-btn { border: 0; border-radius: 50%; background: #fff; box-shadow: 0 10px 24px -14px rgb(40 30 20 / .45); }
  .mo-frame { border-radius: 24px; }
  .mo-item figcaption { border-top: 0; padding-top: 0; margin-top: 12px; }
  .mo-bar { border-radius: 99px; overflow: hidden; }

  .fl-stage { padding: 10px; }
  .fl-panel { border-radius: var(--r); }
  .fl-k { text-transform: none; letter-spacing: -.03em; }
  .l-sum div { border-radius: 20px; background: rgb(255 255 255 / .72); border: 1px solid rgb(255 255 255 / .9); }

  .sec-t { letter-spacing: -.05em; }
  .g-card { border-radius: 26px; background: linear-gradient(160deg, #ffffff 0%, #fff4ec 100%); border: 1px solid rgb(255 255 255 / .9); box-shadow: 0 20px 40px -32px rgb(80 40 10 / .35); }
  .g-m { border-radius: 99px; background: linear-gradient(135deg, #ffe4d4, #ffd0b8); }

  .cta-panel { border-radius: var(--r); background:
    radial-gradient(ellipse 60% 70% at 85% 10%, rgb(255 190 150 / .7), transparent 60%),
    radial-gradient(ellipse 60% 70% at 0% 100%, rgb(200 50 0 / .55), transparent 65%),
    linear-gradient(135deg, #ff8a4c, #fc4c02 55%, #e84300); }
  .pill { border-radius: 99px; }
  .pill svg { border-radius: 50%; }

  @media (max-width: 900px) {
    .ab { --r: 24px; }
    .h-runs { padding: 10px 12px 4px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .st-text span { opacity: 1; }
    .h-sync i { animation: none; }
  }
</style>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { SplitText } from 'gsap/SplitText'
  import { mountHeroGL } from '../scripts/about-hero-gl'
  import { mountRoute } from '../scripts/about-route'
  gsap.registerPlugin(ScrollTrigger, SplitText)
  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)
  const $$ = <T extends Element = HTMLElement>(s: string) => [...document.querySelectorAll<T>(s)]

  // ── "Out there" strip: native horizontal scroll + arrow buttons + mouse drag + progress bar ──
  const strip = $('[data-mo-strip]')
  if (strip) {
    const bar = $('[data-mo-bar]'), prev = $<HTMLButtonElement>('[data-mo-prev]'), next = $<HTMLButtonElement>('[data-mo-next]')
    const imgs = [...strip.querySelectorAll<HTMLElement>('.mo-img')]
    const sync = () => {
      const max = strip.scrollWidth - strip.clientWidth, p = max > 0 ? strip.scrollLeft / max : 0
      if (bar) bar.style.transform = `scaleX(${p.toFixed(3)})`
      if (prev) prev.disabled = strip.scrollLeft < 4
      if (next) next.disabled = strip.scrollLeft > max - 4
      // each photo pans a little inside its frame as it travels across the screen
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const vw = innerWidth
        imgs.forEach((im) => { const r = im.parentElement!.getBoundingClientRect(); const c = (r.left + r.width / 2) / vw - 0.5; im.style.transform = `scale(1.12) translateX(${(-c * 8).toFixed(2)}%)` })
      }
    }
    const step = () => (strip.querySelector('.mo-item') as HTMLElement).offsetWidth + 24
    prev?.addEventListener('click', () => strip.scrollBy({ left: -step(), behavior: 'smooth' }))
    next?.addEventListener('click', () => strip.scrollBy({ left: step(), behavior: 'smooth' }))
    strip.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true })
    addEventListener('resize', sync)
    // drag with a mouse (touch already scrolls natively)
    let down = false, sx = 0, sl = 0, moved = false
    strip.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; down = true; moved = false; sx = e.clientX; sl = strip.scrollLeft; strip.setPointerCapture(e.pointerId) })
    strip.addEventListener('pointermove', (e) => { if (!down) return; const dx = e.clientX - sx; if (Math.abs(dx) > 3) { moved = true; strip.classList.add('drag') } strip.scrollLeft = sl - dx })
    const up = () => { if (!down) return; down = false; strip.classList.remove('drag') }
    strip.addEventListener('pointerup', up); strip.addEventListener('pointercancel', up)
    strip.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation() } }, true)
    sync()
  }


  const reduceM = matchMedia('(prefers-reduced-motion: reduce)').matches
  const photo = $('[data-gl-src]')
  const heroGL = photo ? mountHeroGL(photo, photo.dataset.glSrc!, reduceM) : null

  // ── long-run flyover: route + live readout driven by the same 0..1 ──
  const data = JSON.parse(document.getElementById('run-stream')!.textContent || '{}') as { km: number[]; hr: number[]; v: number[]; kmMax: number }
  const flyHost = $('[data-fly-host]')
  const route = flyHost ? mountRoute(flyHost, reduceM) : null
  const F = (k: string) => $(`[data-f="${k}"]`)!
  const paceOf = (ms: number) => { if (!ms || ms < 0.5) return '–'; const s = 1000 / ms; return `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}` }
  function fly (t: number) {
    route?.set(t)
    const n = data.hr?.length || 0
    if (!n) return
    const i = Math.min(n - 1, Math.round(t * (n - 1)))
    const w = data.v.slice(Math.max(0, i - 3), i + 4)
    F('km').textContent = (t * data.kmMax).toFixed(1)
    F('hr').textContent = t > 0.003 ? String(data.hr[i]) : '–'
    F('pace').textContent = t > 0.003 ? paceOf(w.reduce((a, b) => a + b, 0) / w.length) : '–'
  }
  fly(reduceM ? 1 : 0)

  const mm = gsap.matchMedia()
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    // ── hero intro: "RUN." rises letter by letter once the loader is gone ──
    const runWord = new SplitText('.hw-run', { type: 'chars', charsClass: 'hc' })
    gsap.set('.hw-run', { overflow: 'hidden' })
    gsap.set(runWord.chars, { yPercent: 105 })
    gsap.set('[data-fade]', { autoAlpha: 0, y: 14 })
    const intro = () => {
      gsap.timeline({ defaults: { ease: 'expo.out' } })
        .to(runWord.chars, { yPercent: 0, duration: 1.3, stagger: 0.06, onComplete: () => gsap.set('.hw-run', { overflow: 'visible' }) })
        .to('[data-fade]', { autoAlpha: 1, y: 0, duration: 0.8, stagger: 0.08 }, 0.35)
    }
    ;(window as any).__booted ? intro() : document.addEventListener('boot:done', intro, { once: true })

    // ── hero scroll (pinned by CSS sticky): photo zooms, the sharp ghost melts, letters spread ──
    gsap.timeline({ scrollTrigger: { trigger: '[data-hero]', start: 'top top', end: 'bottom bottom', scrub: 1, onUpdate: (self) => heroGL?.progress(self.progress) } })
      .to('.h-photo', { scale: 1.18, ease: 'none' }, 0)
      .to('.sharp', { opacity: 0, ease: 'none' }, 0)
      .to(runWord.chars, { xPercent: (i) => (i - 1.5) * 26, ease: 'none' }, 0)
      // fade the hero details through a CSS variable, not opacity/transform: the intro animation owns those,
      // and sharing them broke the hero when the page was opened scrolled down and then scrolled back up
      .fromTo('.h-stage', { '--out': 0 }, { '--out': 1, ease: 'none', immediateRender: false }, 0.35)

    // statement: words light up one by one as it scrolls through

    // cards and titles rise in
    $$('[data-up]').forEach((el) => gsap.from(el, { y: 50, autoAlpha: 0, duration: 1.1, ease: 'expo.out', scrollTrigger: { trigger: el, start: 'top 88%' } }))
    ScrollTrigger.batch('[data-card]', { start: 'top 90%', once: true, onEnter: (els) => gsap.from(els, { y: 60, autoAlpha: 0, duration: 1.1, stagger: 0.08, ease: 'expo.out' }) })
    // photo strip drifts in from the right, title lines rise
    gsap.from('[data-mo] .mo-item', { x: 160, autoAlpha: 0, duration: 1.2, stagger: 0.07, ease: 'expo.out', scrollTrigger: { trigger: '.mo-strip', start: 'top 85%' } })
    gsap.from('.mo-title', { yPercent: 60, autoAlpha: 0, duration: 1.1, ease: 'expo.out', scrollTrigger: { trigger: '.mo-title', start: 'top 88%' } })

    // flyover follows the pinned section
    const st = { t: 0 }
    gsap.to(st, { t: 1, ease: 'none', onUpdate: () => fly(st.t), scrollTrigger: { trigger: '[data-fly]', start: 'top top', end: 'bottom bottom', scrub: 0.6 } })

    // CTA panel grows to full size as it arrives
    gsap.from('[data-cta]', { scale: 0.92, ease: 'none', scrollTrigger: { trigger: '[data-cta]', start: 'top bottom', end: 'top 40%', scrub: true } })

    addEventListener('load', () => ScrollTrigger.refresh(), { once: true })
  })
</script>
</Base>
