---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import SilkDivider from '../components/SilkDivider.astro'
import track from '../assets/about/track.jpg'
import jobs from '../assets/about/film-jobs.webp'
import ford from '../assets/about/film-ford.webp'
import spidey from '../assets/about/film-spiderman.webp'
import interstellar from '../assets/about/film-interstellar.webp'
import gtasa from '../assets/about/game-gtasa.webp'
import gta5 from '../assets/about/game-gta5.webp'
import jc4 from '../assets/about/game-jc4.webp'
import pc from '../assets/about/gear-pc.webp'
import hmns from '../assets/about/perfume-hmns.webp'
import esteh from '../assets/about/perfume-esteh.webp'
import dappers from '../assets/about/perfume-dappers.webp'

const games = [
  { t: 'GTA: San Andreas', why: 'for its nostalgic charm and timeless exploration.', img: gtasa, r: -7, x: '0%', y: '26%', z: 3 },
  { t: 'GTA V', why: 'for its dynamic world and thrilling adventures.', img: gta5, r: 5, x: '42%', y: '0%', z: 1 },
  { t: 'Just Cause 4', why: 'for its chaotic action and stress-free fun.', img: jc4, r: -3, x: '40%', y: '56%', z: 2 }
]
const films = [
  { t: 'Jobs', meta: 'Biopic, 2013', img: jobs },
  { t: 'Ford v Ferrari', meta: 'Drama, 2019', img: ford },
  { t: 'Spider-Man: No Way Home', meta: 'Superhero, 2021', img: spidey },
  { t: 'Interstellar', meta: 'Sci-fi, 2014', img: interstellar }
]
const music = [
  { mood: 'Pop-punk that takes me back to my teens', bands: ['Blink-182', 'Neck Deep'] },
  { mood: 'Metal riffs for energy', bands: ['Slayer', 'Napalm Death'] },
  { mood: 'Softer songs for winding down', bands: ['Taylor Swift', 'LANY'] }
]
const perfumes = [
  { t: 'HMNS', n: 'Darker Shade of Orgasm', img: hmns, r: -10 },
  { t: 'Es Teh Manis', n: 'Eau de parfum', img: esteh, r: 0 },
  { t: 'Dappers', n: 'Teh Melati', img: dappers, r: 10 }
]
const rig = ['Ryzen 9 5900X', '30GB DDR4 Corsair', 'RTX 2060 Super', 'ASRock X570 Taichi', '1TB SSD, 1TB HDD', 'Cooler Master 240L V2', 'Windows 11']
const desk = ['MSI Optix G241 144Hz', 'AIRO AIO24X 165Hz', 'Nemesis 1080p webcam', 'Rexus Daxa M71', 'Logitech G203', 'Panasonic TV']
---
<Base title="About | Fadhel Ijlal Falah" description="Fadhel Ijlal Falah, off the clock: running, games, films, music, perfume and gear.">

  <!-- 1. hero: type only, the photo follows -->
  <section class="relative isolate overflow-hidden bg-white px-6 pt-36 pb-16 md:px-12 md:pt-48 md:pb-24">
    <div class="blob blob-a" aria-hidden="true"></div><div class="blob blob-b" aria-hidden="true"></div>
    <div class="mx-auto max-w-6xl">
      <h1 class="headline">Hi, I'm <span class="grad">Fadhel.</span><br />This is me,<br class="hidden md:block" /> off the clock.</h1>
      <div class="intro mt-10 grid gap-8 md:mt-14 md:grid-cols-[1fr_auto] md:items-end">
        <p class="max-w-xl text-lg leading-relaxed text-slate md:text-xl">I run, I play the games I grew up with, I keep pop-punk and metal on repeat, and I have opinions about perfume. Here is a bit of all that.</p>
        <p class="flex items-center gap-2 text-sm font-medium text-navy"><span class="size-2 rounded-full bg-emerald-500"></span>Tangerang, Indonesia</p>
      </div>
    </div>
  </section>

  <!-- running: full-bleed photo card -->
  <section class="bg-white px-4 pb-24 md:px-8 md:pb-32">
    <figure class="track relative mx-auto max-w-7xl overflow-hidden rounded-[36px]">
      <Image src={track} alt="Fadhel leading a group run on a stadium track at night" width={1600} widths={[800, 1200, 1600]} sizes="(min-width: 1280px) 1248px, 96vw" class="aspect-[4/5] w-full object-cover object-[50%_60%] md:aspect-[16/9]" loading="eager" fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-t from-[#0a1f44]/85 via-[#0a1f44]/10 to-transparent"></div>
      <figcaption class="absolute inset-x-0 bottom-0 p-7 md:p-12">
        <p class="text-sm font-medium text-cyan-200">Running</p>
        <p class="mt-2 max-w-2xl text-4xl leading-[1.02] font-bold tracking-[-0.03em] text-white md:text-6xl">Laps on the track, one after another.</p>
      </figcaption>
    </figure>
  </section>

  <!-- 2. games: copy left, fanned covers right -->
  <section class="chapter bg-mist">
    <div class="mx-auto grid max-w-6xl items-center gap-14 md:grid-cols-2">
      <div>
                <h2 data-reveal class="title">Frequently<br />played</h2>
        <p data-reveal class="lede">Gaming is how I relax after a busy day.</p>
        <ul data-reveal class="mt-6 space-y-3 text-slate">
          {games.map((g) => <li><b class="font-semibold text-navy">{g.t}</b> {g.why}</li>)}
        </ul>
      </div>
      <div class="fan relative mx-auto aspect-square w-full max-w-[520px]">
        <div class="rings" aria-hidden="true"></div>
        {games.map((g, i) => (
          <figure data-reveal class="tilt polaroid absolute w-[56%]" style={`--r:${g.r}deg;left:${g.x};top:${g.y};z-index:${g.z};transition-delay:${i * 90}ms`}>
            <Image src={g.img} alt={`${g.t} cover art`} width={460} widths={[320, 460]} sizes="(min-width: 768px) 300px, 55vw" class="aspect-[4/3] w-full rounded-[14px] object-cover" loading="lazy" />
            <figcaption class="pt-2.5 text-center text-sm font-semibold text-navy">{g.t}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. films: big title, poster strip -->
  <section class="chapter bg-white">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <h2 data-reveal class="title">Top picks<br />in films</h2>
        <p data-reveal class="lede max-w-sm md:text-right">Mostly stories about people who build things. And one about space.</p>
      </div>
      <ul class="no-bar -mx-6 mt-12 flex snap-x snap-mandatory scroll-px-6 gap-4 overflow-x-auto px-6 pb-4 md:mx-0 md:grid md:grid-cols-4 md:overflow-visible md:px-0">
        {films.map((f, i) => (
          <li data-reveal class="poster w-[46vw] shrink-0 snap-start md:w-auto" style={`transition-delay:${i * 80}ms`}>
            <Image src={f.img} alt={`${f.t} poster`} width={300} widths={[240, 300]} sizes="(min-width: 768px) 270px, 46vw" class="aspect-[3/4] w-full rounded-[18px] object-cover object-top" loading="lazy" />
            <p class="mt-4 font-semibold leading-snug text-navy">{f.t}</p>
            <p class="text-sm text-slate">{f.meta}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. music: typographic, band names as the visual -->
  <section class="chapter relative isolate overflow-hidden bg-white">
    <SilkDivider above="#ffffff" />
    <div class="relative mx-auto max-w-6xl pt-24 md:pt-40">
      <h2 data-reveal class="title text-center">On repeat</h2>
      <p data-reveal class="lede mx-auto max-w-md text-center">Music has always been my escape and my inspiration.</p>
      <div class="mt-14 space-y-10">
        {music.map((m, i) => (
          <div data-reveal class:list={['flex flex-col gap-2', i % 2 ? 'items-end text-right' : 'items-start']}>
            <p class="text-sm font-medium text-slate">{m.mood}</p>
            <p class="band text-[clamp(2.4rem,7vw,5.5rem)] leading-none font-bold tracking-[-0.04em]">
              {m.bands.map((b, k) => <>{k > 0 && <span class="text-slate-300"> / </span>}<span class="grad">{b}</span></>)}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. perfume: fanned bottles -->
  <section class="chapter bg-mist">
    <div class="mx-auto grid max-w-6xl items-center gap-14 md:grid-cols-2">
      <div class="order-2 flex justify-center md:order-1">
        {perfumes.map((p, i) => (
          <figure data-reveal class="tilt polaroid -mx-2 w-[36%] max-w-[200px] bg-white" style={`--r:${p.r}deg;z-index:${i === 1 ? 3 : 1};transition-delay:${i * 90}ms;margin-top:${i === 1 ? 0 : 2.5}rem`}>
            <Image src={p.img} alt={`${p.t} perfume bottle`} width={180} class="aspect-[4/5] w-full object-contain p-3" loading="lazy" />
            <figcaption class="px-1 text-center"><p class="text-sm font-semibold text-navy">{p.t}</p><p class="text-[11px] leading-tight text-slate">{p.n}</p></figcaption>
          </figure>
        ))}
      </div>
      <div class="order-1 md:order-2">
        <h2 data-reveal class="title">Wearing<br />lately</h2>
        <p data-reveal class="lede">Scent is a quiet way to show personality. These three cover a laid-back day out and a more formal evening.</p>
      </div>
    </div>
  </section>

  <!-- 6. gear -->
  <section class="chapter bg-white">
    <div class="mx-auto max-w-6xl">
      <h2 data-reveal class="title">Gear</h2>
      <p data-reveal class="lede">What I play, and tinker, on.</p>
      <div class="mt-12 grid gap-10 md:grid-cols-[1.1fr_0.9fr]">
        <Image data-reveal src={pc} alt="Inside the desktop PC, lit purple" width={640} widths={[400, 640]} sizes="(min-width: 768px) 560px, 90vw" class="aspect-[4/3] w-full rounded-[24px] object-cover" loading="lazy" />
        <div class="flex flex-col justify-between gap-10">
          <div data-reveal>
            <p class="text-sm font-medium text-slate">Laptop</p>
            <p class="mt-1 text-[clamp(2.4rem,5vw,3.75rem)] leading-none font-bold tracking-[-0.03em] text-navy">MacBook Pro M2</p>
            <p class="mt-3 text-sm font-medium text-slate">Phones</p>
            <p class="mt-1 text-2xl font-semibold tracking-tight text-navy">Samsung S21 FE, iPhone 15</p>
          </div>
          <div data-reveal class="grid grid-cols-2 gap-6 text-sm">
            <div><p class="font-medium text-slate">Desktop</p><ul class="mt-2 space-y-1.5 text-navy">{rig.map((r) => <li>{r}</li>)}</ul></div>
            <div><p class="font-medium text-slate">Desk</p><ul class="mt-2 space-y-1.5 text-navy">{desk.map((r) => <li>{r}</li>)}</ul></div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .blob { position: absolute; border-radius: 50%; filter: blur(80px); opacity: .55; z-index: -1; }
  .blob-a { width: 46vmax; height: 46vmax; left: -14vmax; top: 10%; background: radial-gradient(circle, #bfdbfe, transparent 70%); }
  .blob-b { width: 40vmax; height: 40vmax; right: -12vmax; top: 30%; background: radial-gradient(circle, #a7f3d0, transparent 70%); }
  .headline { font-size: clamp(2.8rem, 7.5vw, 6.5rem); line-height: 1; font-weight: 700; letter-spacing: -0.045em; color: var(--color-navy); animation: rise 1.1s cubic-bezier(.16,1,.3,1) both; }
  .intro { animation: rise 1.1s .15s cubic-bezier(.16,1,.3,1) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(32px); } }
  @media (prefers-reduced-motion: reduce) { .headline, .intro { animation: none; } }
  .chapter { padding: 7rem 1.5rem; }
  @media (min-width: 768px) { .chapter { padding: 9rem 3rem; min-height: 90vh; display: flex; align-items: center; } .chapter > div { width: 100%; } }
  .kicker { font-size: .875rem; font-weight: 600; color: #2563eb; }
  .title { margin-top: .75rem; font-size: clamp(2.8rem, 7vw, 5.5rem); line-height: .98; font-weight: 700; letter-spacing: -0.04em; color: var(--color-navy); }
  .lede { margin-top: 1.25rem; font-size: 1.125rem; line-height: 1.65; color: var(--color-slate); }
  .grad { background: linear-gradient(100deg, #2563eb, #0ea5e9 45%, #10b981); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }

  /* instant-photo cards that sit at an angle and straighten on hover */
  .polaroid { padding: .6rem .6rem .75rem; border-radius: 24px; background: rgb(255 255 255 / .85); border: 1px solid rgb(226 232 240); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 30px 60px -30px rgb(37 99 235 / .35); transform: rotate(var(--r, 0deg)); }
  [data-reveal].polaroid { transform: translateY(24px) rotate(var(--r, 0deg)); }
  [data-reveal].polaroid.in { transform: rotate(var(--r, 0deg)); }
  .tilt { transition: transform .6s cubic-bezier(.34,1.56,.64,1), opacity .9s ease; }
  .tilt:hover { transform: rotate(0deg) scale(1.04) !important; z-index: 10 !important; }
  .rings { position: absolute; inset: 4%; border-radius: 50%; background:
    radial-gradient(circle, rgb(16 185 129 / .12) 0 30%, transparent 30.5%),
    radial-gradient(circle, transparent 0 48%, rgb(37 99 235 / .1) 48.5% 49%, transparent 49.5%),
    radial-gradient(circle, transparent 0 68%, rgb(14 165 233 / .1) 68.5% 69%, transparent 69.5%); }
  .poster img { transition: transform .7s cubic-bezier(.16,1,.3,1); }
  .poster:hover img { transform: translateY(-6px); }
  .no-bar { scrollbar-width: none; } .no-bar::-webkit-scrollbar { display: none; }
  @media (prefers-reduced-motion: reduce) { .tilt, .poster img { transition: none; } }
</style>
