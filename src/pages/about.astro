---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import track from '../assets/about/track.jpg'

const strava = 'https://strava.app.link/E63xhR6AR7b'
const runGear = [
  { k: 'Watch', t: 'Garmin Forerunner 165' },
  { k: 'Shoes', t: 'ASICS Superblast 3' },
  { k: 'Shoes', t: 'adidas Adizero Boston 13' },
  { k: 'Trail shoes', t: 'ASICS Novablast 5 TR' },
  { k: 'Also', t: 'Camp SR3D' }
]
const nav = [
  { href: '#run', label: 'Run', id: 'run', note: 'Laps on the track', icon: 'M13 4a2 2 0 1 0 0 .01M7 21l3-6 3 2v4M10 15l1-5 4 3 3-1M8 9l3-2', track: true },
  { href: '#ride', label: 'Ride', id: 'ride', note: 'Road and MTB', icon: 'M5.5 17.5a3.5 3.5 0 1 0 0-.01M18.5 17.5a3.5 3.5 0 1 0 0-.01M5.5 17.5L9 9h6l3.5 8.5M9 9l3 8.5 3-8.5M8 6h3', track: true },
  { href: '#strava', label: 'Strava', id: 'strava', note: 'Follow the activity', icon: 'M15 3l-5 10h4l1-2 3 6h3L15 3zM9 13l-4 8h4l2-4', track: true },
  { href: '/', label: 'Home', id: 'home', note: 'Back to the main page', icon: 'M4 11l8-7 8 7v9H4z' }
]
---
<Base nav={nav} page="About" title="About | Fadhel Ijlal Falah" description="Fadhel Ijlal Falah off the clock: running and riding, tracked on Strava.">
<canvas id="route" class="pointer-events-none fixed inset-0 z-0 h-full w-full" aria-hidden="true"></canvas>
<div class="sport relative z-10">

  <section data-route="0" class="flex min-h-[100svh] items-start px-6 pt-28 md:items-center md:px-12 md:pt-0">
    <div class="mx-auto w-full max-w-6xl">
      <p class="in text-sm font-semibold text-[#fc4c02]">Off the clock</p>
      <h1 class="in big mt-4">Run.<br />Ride.<br /><span class="grad">Repeat.</span></h1>
      <p class="in mt-6 max-w-sm text-lg leading-relaxed text-slate" style="animation-delay:.15s">When I'm not at a desk, I'm on the track or on the bike. Every kilometre ends up on Strava.</p>
    </div>
  </section>

  <section id="run" data-route="0" class="scroll-mt-16 px-6 py-24 md:px-12 md:py-32">
    <div class="mx-auto grid max-w-6xl items-end gap-10 md:grid-cols-[1.1fr_0.9fr]">
      <figure data-reveal class="glass overflow-hidden rounded-[32px] p-2">
        <Image src={track} alt="Fadhel leading a group run on a stadium track at night" width={1600} widths={[800, 1200, 1600]} sizes="(min-width: 768px) 640px, 92vw" class="aspect-[4/5] w-full rounded-[26px] object-cover object-[50%_60%]" loading="lazy" />
      </figure>
      <div class="glass rounded-[28px] p-7 md:p-9">
        <p data-reveal class="kicker">Run</p>
        <h2 data-reveal class="title">Laps on <span class="grad">the track.</span></h2>
        <p data-reveal class="lede">Track sessions, long runs, and the occasional ultra.</p>
        <ul class="mt-8 divide-y divide-slate-200/80 border-y border-slate-200/80">
          {runGear.map((g, i) => (
            <li data-reveal class="kit flex items-baseline justify-between gap-4 py-3.5" style={`transition-delay:${i * 60}ms`}>
              <span class="text-sm text-slate">{g.k}</span><span class="text-right font-semibold text-navy">{g.t}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="ride" data-route="1" class="scroll-mt-16 flex min-h-[90svh] items-center px-6 py-24 md:px-12">
    <div class="mx-auto w-full max-w-6xl">
      <div class="max-w-md">
        <p data-reveal class="kicker">Ride</p>
        <h2 data-reveal class="title">Road and <span class="grad">dirt.</span></h2>
        <p data-reveal class="lede">When the legs need a break from running, I ride: long road loops, or the MTB on the trails.</p>
      </div>
    </div>
  </section>

  <section id="strava" data-route="1" class="scroll-mt-16 px-6 pt-16 pb-32 md:px-12 md:pb-44">
    <div data-reveal class="glass mx-auto max-w-3xl rounded-[32px] px-8 py-14 text-center md:py-20">
      <h2 class="title">Follow the <span class="text-[#fc4c02]">activity.</span></h2>
      <p class="lede mx-auto max-w-md">Runs, rides and everything in between, as they happen.</p>
      <a href={strava} target="_blank" rel="noopener" class="strava mt-10 inline-flex items-center gap-3 rounded-full px-8 py-4 text-lg font-semibold text-white">
        Follow me on Strava
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
      </a>
    </div>
  </section>
</div>
</Base>

<script>
  import { mountRoute } from '../scripts/route-scene'
  const c = document.getElementById('route') as HTMLCanvasElement | null
  if (c) mountRoute(c, [...document.querySelectorAll<HTMLElement>('[data-route]')])
</script>

<style>
  :global(body:has(.sport)) { background: #fbfcff; }
  .big { font-size: clamp(3.6rem, 11vw, 9rem); line-height: .9; font-weight: 800; letter-spacing: -0.05em; color: var(--color-navy); }
  .title { margin-top: .75rem; font-size: clamp(2.6rem, 6vw, 4.75rem); line-height: .98; font-weight: 700; letter-spacing: -0.04em; color: var(--color-navy); }
  .kicker { font-size: .875rem; font-weight: 600; color: #2563eb; }
  .lede { margin-top: 1.25rem; font-size: 1.125rem; line-height: 1.65; color: var(--color-slate); }
  .grad { background: linear-gradient(100deg, #2563eb, #0ea5e9 50%, #10b981); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .glass { background: rgb(255 255 255 / .7); border: 1px solid rgb(255 255 255 / .95); box-shadow: 0 24px 60px -36px rgb(37 99 235 / .45); backdrop-filter: blur(18px) saturate(160%); -webkit-backdrop-filter: blur(18px) saturate(160%); }
  .kit { transition: transform .5s cubic-bezier(.34,1.56,.64,1), opacity .9s ease; } .kit:hover { transform: translateX(6px); }
  .strava { background: #fc4c02; box-shadow: 0 18px 40px -16px rgb(252 76 2 / .7); transition: transform .4s cubic-bezier(.34,1.56,.64,1); }
  .strava:hover { transform: translateY(-2px) scale(1.03); }
  .in { animation: rise 1.1s cubic-bezier(.16,1,.3,1) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(32px); } }
  @media (prefers-reduced-motion: reduce) { .in { animation: none; } }
</style>
