---
import Header from "@/Components/header";
import Layout from "Containers/layout";
import {stripHtml} from "Helpers/utils"
import Bg from '@/Assets/img/blog/blog-list-bg.jpg'
import BgM from '@/Assets/img/blog/blog-list-bg-m.jpg'
import Navbar from 'Containers/navbar/navbar'
import BlogList from "Containers/blogList"
import {frontmatter} from 'Consts/blog'

export async function getStaticPaths({ paginate }: any) {
    const allPosts = await Astro.glob('../../pages/blog/**/*.mdx');
  // Generate pages from our array of astronauts, with 2 to a page
  return paginate(allPosts, { pageSize: 6 });
}
// All paginated data is passed on the "page" prop
const { page } = Astro.props;
---

<Layout titlePage={stripHtml(frontmatter.title)} >

    <Navbar client:load/>

    <div class="px-8 md:px-0 flex flex-col gap-y-20 md:!gap-0 !justify-end md:!justify-center">
        <Header variant="blog-list" bgImg={Bg.src} bgImgM={BgM.src} {...frontmatter} />
    </div>
    <BlogList page={page} />
    </Layout>