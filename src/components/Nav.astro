---
import { Image } from 'astro:assets'
import logo from '../assets/logo.png'
import { site } from '../data/site'
export type NavLink = { href: string; label: string; id: string; note: string; icon: string; track?: boolean; children?: NavLink[] }
interface Props { links?: NavLink[]; page?: string; theme?: 'sport' }
const homeLinks: NavLink[] = [
  { href: '/#work', label: 'Work', id: 'work', note: 'Roles, synced from LinkedIn', icon: 'M4 7h16v12H4zM9 7V5h6v2', track: true },
  { href: '/#oss', label: 'Open source', id: 'oss', note: 'Tools I build in public', icon: 'M8 9l-4 3 4 3M16 9l4 3-4 3M13 6l-2 12', track: true },
  { href: '/#projects', label: 'Projects', id: 'projects', note: 'Apps I have shipped', icon: 'M4 5h7v7H4zM13 5h7v4h-7zM13 11h7v8h-7zM4 14h7v5H4z', track: true },
  { href: '#', label: 'Pages', id: 'pages', note: 'More of me', icon: 'M5 4h10l4 4v12H5zM14 4v5h5', children: [
    { href: '/about/', label: 'About', id: 'about', note: 'Run, ride, Strava', icon: 'M13 4a2 2 0 1 0 0 .01M7 21l3-6 3 2v4M10 15l1-5 4 3 3-1M8 9l3-2' }
  ] },
  { href: '/#contact', label: 'Contact', id: 'contact', note: "Let's work together", icon: 'M4 6h16v12H4zM4 7l8 6 8-6', track: true }
]
const { links = homeLinks, page = 'Menu', theme } = Astro.props
---
<!-- Dynamic-Island menu: live-site pill, gradient ring, scroll progress, expands into a panel -->
<header class="pointer-events-none fixed inset-x-0 top-4 z-50 flex justify-end px-3 md:top-6 md:px-8">
  <nav id="island" aria-label="Main" data-page={page} data-theme={theme} class="island pointer-events-auto max-w-[calc(100vw-1.5rem)]">
    <div class="island-inner">
      <div id="island-row" class="flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 py-2 pr-3 pl-2.5 font-semibold text-navy">
          <span class="grid size-8 place-items-center rounded-full bg-white shadow-[inset_0_0_0_1px_rgb(46_62_106_/_0.08)]">
            <Image src={logo} alt="" width={22} height={22} densities={[1, 2, 3]} class="size-[22px]" loading="eager" />
          </span>
          <span class="text-[17px] tracking-tight">Fadhel</span>
        </a>
        <button id="island-toggle" type="button" aria-expanded="false" aria-controls="island-menu"
                class="mr-1.5 flex items-center gap-2 rounded-full bg-slate-900/[0.04] py-1.5 pr-1.5 pl-4 text-sm text-navy transition-colors hover:bg-slate-900/[0.07]">
          <!-- scroll progress ring -->
          <span id="island-label" class="island-label min-w-[4.2rem] text-left font-medium">Menu</span>
          <span class="island-prog relative grid size-6 place-items-center" aria-hidden="true">
          <svg class="island-ringsvg absolute inset-0 size-6 -rotate-90" viewBox="0 0 24 24">
            <defs><linearGradient id="ring" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2563eb" /><stop offset="1" stop-color="#10b981" /></linearGradient></defs>
            <circle cx="12" cy="12" r="9" fill="none" stroke="rgb(46 62 106 / .1)" stroke-width="2.5" />
            <circle id="island-ring" cx="12" cy="12" r="9" fill="none" stroke="url(#ring)" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="56.55" stroke-dashoffset="56.55" style="transition: stroke-dashoffset .6s cubic-bezier(.16,1,.3,1)" />
          </svg>
          <svg class="island-check size-6" viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="#10b981" /><path d="M7.5 12.4l3 3 6-6.3" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        </button>
      </div>

      <div id="island-menu" class="island-menu">
        <div>
          <div id="island-panel" class="w-[min(24rem,calc(100vw-3rem))] px-2 pt-1 pb-2">
            <ul class="space-y-0.5">
              {links.map((l, i) => (
                <li class="island-item" style={`--i:${i}`}>
                  {l.children ? (
                    <div class="island-group">
                      <button type="button" aria-expanded="false" class="island-sub group flex w-full items-center gap-3 rounded-2xl px-2.5 py-2 text-left transition-colors hover:bg-slate-900/[0.04]">
                        <span class="island-ic grid size-9 shrink-0 place-items-center rounded-xl text-blue-600">
                          <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={l.icon} /></svg>
                        </span>
                        <span class="min-w-0 flex-1">
                          <span class="block text-[15px] font-medium text-navy">{l.label}</span>
                          <span class="block truncate text-xs text-slate-500">{l.note}</span>
                        </span>
                        <svg class="island-chev size-4 text-slate-400 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
                      </button>
                      <div class="island-subwrap"><ul class="overflow-hidden">
                        {l.children.map((c) => (
                          <li>
                            <a href={c.href} data-id={c.id} class="island-link group ml-6 flex items-center gap-3 rounded-2xl px-2.5 py-2 transition-colors hover:bg-slate-900/[0.04]">
                              <span class="island-ic grid size-8 shrink-0 place-items-center rounded-xl text-blue-600">
                                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={c.icon} /></svg>
                              </span>
                              <span class="min-w-0 flex-1">
                                <span class="block text-sm font-medium text-navy">{c.label}</span>
                                <span class="block truncate text-xs text-slate-500">{c.note}</span>
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul></div>
                    </div>
                  ) : (
                  <a href={l.href} data-id={l.id} data-track={l.track ? '1' : undefined} class="island-link group flex items-center gap-3 rounded-2xl px-2.5 py-2 transition-colors hover:bg-slate-900/[0.04]">
                    <span class="island-ic grid size-9 shrink-0 place-items-center rounded-xl text-blue-600">
                      <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={l.icon} /></svg>
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="block text-[15px] font-medium text-navy">{l.label}</span>
                      <span class="block truncate text-xs text-slate-500">{l.note}</span>
                    </span>
                    <svg class="size-4 -translate-x-1 text-slate-400 opacity-0 transition group-hover:translate-x-0 group-hover:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6" /></svg>
                  </a>
                  )}
                </li>
              ))}
            </ul>
            <div class="island-item mt-2 flex gap-2" style="--i:4">
            <a href={`mailto:${site.email}`} class="island-cta flex flex-1 items-center justify-between rounded-2xl px-4 py-3 text-sm font-semibold text-white">
              <span>Get in touch</span>
              <span class="flex items-center gap-1.5 text-xs font-medium text-white/85"><span class="size-1.5 rounded-full bg-emerald-300"></span>Open to work</span>
            </a>
              <button id="island-top" type="button" aria-label="Back to top" class="island-top grid w-12 shrink-0 place-items-center rounded-2xl bg-slate-900/[0.05] text-navy transition-colors hover:bg-slate-900/[0.09]">
                <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  /* until JS has measured the pill, show only the closed row (no flash of the open panel, no layout shift) */
  .island:not(.sized) #island-menu { display: none; }
  /* gradient hairline ring around the glass pill */
  .island { position: relative; border-radius: 26px; padding: 1px;
    background: linear-gradient(120deg, rgb(37 99 235 / .45), rgb(255 255 255 / .9) 40%, rgb(16 185 129 / .45));
    box-shadow: 0 10px 30px -14px rgb(37 99 235 / .35);
    transition: border-radius .6s var(--spring, cubic-bezier(.32,.72,0,1)); }
  .island-inner { border-radius: 25px; background: rgb(255 255 255 / .82); backdrop-filter: blur(24px) saturate(180%); -webkit-backdrop-filter: blur(24px) saturate(180%); overflow: hidden; will-change: width, height;
    transition: width .62s var(--spring, cubic-bezier(.32,.72,0,1)), height .62s var(--spring, cubic-bezier(.32,.72,0,1)), border-radius .62s var(--spring, cubic-bezier(.32,.72,0,1)), background .3s ease; }
  #island-row { width: 100%; }
  #island.open .island-inner { background: rgb(255 255 255 / 1); border-radius: 28px; }
  #island.open { border-radius: 29px; }
  .island-ic { background: #eff6ff; }
  .island-link.active .island-ic { background: #2563eb; color: #fff; }
  .island-cta { background: linear-gradient(110deg, #2563eb, #0ea5e9 50%, #10b981); background-size: 200% 100%; transition: background-position .6s ease; }
  .island-cta:hover { background-position: 100% 0; }

  /* content: hidden instantly on close, blur/fade/slide in with a stagger on open */
  .island-menu { width: max-content; }
  #island-row > * { flex-shrink: 0; }
  .island-subwrap { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .45s var(--spring, cubic-bezier(.32,.72,0,1)); }
  .island-group.open .island-subwrap { grid-template-rows: 1fr; }
  .island-group.open .island-chev { transform: rotate(180deg); }
  .island-item { opacity: 0; transform: translateY(-10px) scale(.97); filter: blur(6px); transform-origin: top right;
    transition: opacity .18s ease, transform .18s ease, filter .18s ease; }
  #island.open .island-item { opacity: 1; transform: none; filter: none;
    transition: opacity .4s ease, transform .55s var(--spring, cubic-bezier(.32,.72,0,1)), filter .4s ease;
    transition-delay: calc(90ms + var(--i) * 35ms); }

  .island-top { transition: width .4s var(--spring, ease), opacity .25s ease, margin .4s ease; }
  #island:not(.scrolled) .island-top { width: 0; opacity: 0; margin-left: -.5rem; pointer-events: none; }
  .island-check { transform: scale(0); opacity: 0; transition: transform .45s cubic-bezier(.34,1.56,.64,1), opacity .2s ease; }
  .island-check path { stroke-dasharray: 16; stroke-dashoffset: 16; transition: stroke-dashoffset .35s ease .15s; }
  .island-ringsvg { transition: opacity .2s ease, transform .3s ease; }
  .island-prog.done .island-check { transform: scale(1); opacity: 1; }
  .island-prog.done .island-check path { stroke-dashoffset: 0; }
  .island-prog.done .island-ringsvg { opacity: 0; transform: rotate(-90deg) scale(.6); }
  .island-label.swap { animation: swap .45s cubic-bezier(.16,1,.3,1); }
  @keyframes swap { 0% { opacity: 0; transform: translateY(8px); filter: blur(4px); } 100% { opacity: 1; transform: none; filter: none; } }
  @media (prefers-reduced-motion: reduce) { .island-inner, .island-item { transition: none !important; } }

  /* sport theme (About): smoked glass, white type, Strava orange */
  #island[data-theme='sport'] { background: linear-gradient(120deg, rgb(255 255 255 / .28), rgb(255 255 255 / .06) 45%, rgb(252 76 2 / .7)); box-shadow: 0 14px 34px -16px rgb(0 0 0 / .45); }
  #island[data-theme='sport'] .island-inner { background: rgb(23 23 26 / .62); backdrop-filter: blur(20px) saturate(140%); -webkit-backdrop-filter: blur(20px) saturate(140%); }
  #island[data-theme='sport'].open .island-inner { background: rgb(23 23 26 / .94); }
  #island[data-theme='sport'] .text-navy { color: #fff; }
  #island[data-theme='sport'] .text-slate-500 { color: #a3a29e; }
  #island[data-theme='sport'] .text-slate-400 { color: #75746f; }
  #island[data-theme='sport'] #island-toggle, #island[data-theme='sport'] .island-top { background: rgb(255 255 255 / .1); }
  #island[data-theme='sport'] #island-toggle:hover, #island[data-theme='sport'] .island-top:hover,
  #island[data-theme='sport'] .island-link:hover, #island[data-theme='sport'] .island-sub:hover { background: rgb(255 255 255 / .08); }
  #island[data-theme='sport'] #ring stop { stop-color: #fc4c02; }
  #island[data-theme='sport'] #ring stop + stop { stop-color: #ffa065; }
  #island[data-theme='sport'] .island-ringsvg circle:first-child { stroke: rgb(255 255 255 / .18); }
  #island[data-theme='sport'] .island-check circle { fill: #fc4c02; }
  #island[data-theme='sport'] .island-ic { background: rgb(255 255 255 / .08); color: #ff7a3d; }
  #island[data-theme='sport'] .island-link.active .island-ic { background: #fc4c02; color: #fff; }
  #island[data-theme='sport'] .island-cta { background: #fc4c02; }
  #island[data-theme='sport'] .island-cta:hover { background: #e34402; }
  #island[data-theme='sport'] .bg-emerald-300 { background: #fff; }
  /* squarer, sporty corners */
  #island[data-theme='sport'], #island[data-theme='sport'].open { border-radius: 6px; }
  #island[data-theme='sport'] .island-inner, #island[data-theme='sport'].open .island-inner { border-radius: 5px; }
  #island[data-theme='sport'] #island-toggle { border-radius: 3px; }
  #island[data-theme='sport'] #island-row a > span:first-child { border-radius: 3px; }
  #island[data-theme='sport'] .island-link, #island[data-theme='sport'] .island-sub,
  #island[data-theme='sport'] .island-cta, #island[data-theme='sport'] .island-top { border-radius: 3px; }
  #island[data-theme='sport'] .island-ic { border-radius: 2px; }
</style>

<script>
  const island = document.getElementById('island')!
  const toggle = document.getElementById('island-toggle')!
  const label = document.getElementById('island-label')!
  const ring = document.getElementById('island-ring')!
  const prog_ = island.querySelector('.island-prog')!
  const inner = island.querySelector<HTMLElement>('.island-inner')!
  const row = document.getElementById('island-row')!
  const panel = document.getElementById('island-panel')!

  // iOS-like spring (critically-under-damped) baked into a CSS linear() easing
  const spring = (() => {
    const k = 170, c = 22, m = 1, N = 48, T = 0.62; let x = 0, v = 0; const pts: string[] = []
    const dt = T / N / 8
    for (let i = 0; i <= N; i++) { pts.push(x.toFixed(4)); for (let j = 0; j < 8; j++) { const a = (-k * (x - 1) - c * v) / m; v += a * dt; x += v * dt } }
    pts[pts.length - 1] = '1'
    return `linear(${pts.join(', ')})`
  })()
  if (CSS.supports('transition-timing-function', spring)) island.style.setProperty('--spring', spring)

  const size = () => {
    const open = island.classList.contains('open')
    const natural = [...row.children].reduce((n, el) => { const cs = getComputedStyle(el); return n + (el as HTMLElement).offsetWidth + parseFloat(cs.marginLeft) + parseFloat(cs.marginRight) }, 0) + 1
    const w = open ? Math.max(natural, panel.offsetWidth) : natural
    const h = open ? row.offsetHeight + panel.offsetHeight : row.offsetHeight
    inner.style.width = w + 'px'; inner.style.height = h + 'px'
  }
  const setOpen = (o: boolean) => {
    if (island.classList.contains('open') === o) return
    island.classList.toggle('open', o); toggle.setAttribute('aria-expanded', String(o)); size()
  }
  const close = () => setOpen(false)
  // expandable groups inside the panel (e.g. Pages → About); the island re-measures as the group grows
  island.querySelectorAll<HTMLElement>('.island-group').forEach((g) => {
    const b = g.querySelector('button')!
    b.addEventListener('click', (e) => {
      e.stopPropagation(); const o = !g.classList.contains('open'); g.classList.toggle('open', o); b.setAttribute('aria-expanded', String(o))
      const t0 = performance.now(); const tick = () => { size(); if (performance.now() - t0 < 500) requestAnimationFrame(tick) }; tick()
    })
  })
  requestAnimationFrame(() => { inner.style.transition = 'none'; size(); island.classList.add('sized'); void inner.offsetWidth; inner.style.transition = '' })
  addEventListener('resize', size)
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches
  if (fine) {
    let t = 0
    island.addEventListener('pointerenter', () => { clearTimeout(t); setOpen(true) })
    island.addEventListener('pointerleave', () => { t = window.setTimeout(close, 120) })
  }
  island.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) return
    setOpen(fine ? true : !island.classList.contains('open')); y0 = scrollY
  })
  document.addEventListener('click', (e) => { if (!island.contains(e.target as Node)) close() })
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close() })
  island.querySelectorAll('a').forEach(a => a.addEventListener('click', close))
  document.getElementById('island-top')!.addEventListener('click', (e) => { e.stopPropagation(); close(); scrollTo({ top: 0, behavior: 'smooth' }) })
  const onScrolled = () => island.classList.toggle('scrolled', scrollY > innerHeight * 0.5)
  addEventListener('scroll', onScrolled, { passive: true }); onScrolled()
  let y0 = scrollY

  // scroll progress ring
  const C = 56.55
  const prog = () => {
    if (Math.abs(scrollY - y0) > 40 && island.classList.contains('open')) close()
  }
  addEventListener('scroll', prog, { passive: true }); prog()

  // label + active item follow the section you're reading
  // sections to follow come from this page's menu items (data-track); the pill shows the page name at the top
  const home = island.dataset.page || 'Menu'
  const tracked = [...island.querySelectorAll<HTMLElement>('.island-link[data-track]')]
  const names: Record<string, string> = Object.fromEntries(tracked.map(a => [a.dataset.id!, a.querySelector('.text-\\[15px\\]')?.textContent?.trim() || a.dataset.id!]))
  if (home !== 'Menu') label.textContent = home
  const links = [...island.querySelectorAll<HTMLElement>('.island-link')]
  const order = Object.keys(names)
  const step = (id: string | null) => {   // ring fills one step per section; Contact = complete
    const p = id ? (order.indexOf(id) + 1) / order.length : 0
    ring.setAttribute('stroke-dashoffset', String(C * (1 - p)))
    prog_.classList.toggle('done', p >= 1)
  }
  const set = (id: string | null) => {
    step(id)
    const t = id ? names[id] : home
    links.forEach(a => a.classList.toggle('active', a.dataset.id === id))
    if (label.textContent === t) return
    label.textContent = t; label.classList.remove('swap'); void label.offsetWidth; label.classList.add('swap'); size()
  }
  const secs = Object.keys(names).map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[]
  const io = new IntersectionObserver((es) => es.forEach(e => { if (e.isIntersecting) set(e.target.id) }), { rootMargin: '-45% 0px -50% 0px' })
  secs.forEach(s => io.observe(s))
  addEventListener('scroll', () => { if (scrollY < innerHeight * 0.4) set(null) }, { passive: true })
</script>
