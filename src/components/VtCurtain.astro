---
// Page-transition curtain: a colour panel with wavy silk edges (same geometry as the hero / divider ribbon).
// Rendered once as <template>s; Base's pagereveal handler clones the right one while a page transition runs.
// Orange (Strava) when arriving on About, the site's blue→teal when arriving on Home.
import { VW, VH, cy, band, twist } from '../lib/silk-svg'
const N = 26, step = 24
const xs: number[] = []
for (let x = -20; x <= VW + 20; x += step) xs.push(x)
const fill = 'M-20 ' + (VH + 1) + xs.map((x) => `L${x} ${cy(x).toFixed(1)}`).join('') + `L${VW + 20} ${VH + 1}Z`
const threads = Array.from({ length: N }, (_, i) => {
  const k = i / (N - 1) - 0.5
  return { d: 'M' + xs.map((x) => `${x} ${(cy(x) + k * band(x) * twist(x)).toFixed(1)}`).join('L'), o: (0.35 + 0.65 * (1 - Math.abs(k) * 2)).toFixed(2) }
})
const themes = {
  about: { fill: ['#fc4c02', '#ff8a3d'], stops: ['#e84402', '#fc4c02', '#ff7a1a', '#ffa25c', '#ffc38a'] },
  home: { fill: ['#3b82f6', '#14b8a6'], stops: ['#2563eb', '#0ea5e9', '#22d3ee', '#14b8a6', '#10b981'] }
}
const wave = (id: string, t: { fill: string[]; stops: string[] }) => `<svg viewBox="0 0 ${VW} ${VH}" preserveAspectRatio="none" aria-hidden="true">
<defs><linearGradient id="vt-g-${id}" x1="0" x2="1">${t.stops.map((c, i) => `<stop offset="${i / (t.stops.length - 1)}" stop-color="${c}"/>`).join('')}</linearGradient>
<linearGradient id="vt-p-${id}" x1="0" x2="1">${t.fill.map((c, i) => `<stop offset="${i / (t.fill.length - 1)}" stop-color="${c}"/>`).join('')}</linearGradient></defs>
<path d="${fill}" fill="url(#vt-p-${id})"/>
<g stroke="url(#vt-g-${id})" fill="none" stroke-linecap="round">${threads.map((h) => `<path d="${h.d}" stroke-width="1.6" opacity="${h.o}" vector-effect="non-scaling-stroke"/>`).join('')}</g></svg>`
const html = (id: 'about' | 'home') => {
  const w = wave(id, themes[id])
  const body = `linear-gradient(90deg,${themes[id].fill.join(',')})`
  return `<div class="vt-curtain" data-to="${id}"><div class="vt-c-inner"><div class="vt-c-wave">${w}</div><div class="vt-c-body" style="background:${body}"></div><div class="vt-c-wave vt-c-flip">${w}</div></div></div>`
}
---
<template id="vt-curtain-about" set:html={html('about')} />
<template id="vt-curtain-home" set:html={html('home')} />
