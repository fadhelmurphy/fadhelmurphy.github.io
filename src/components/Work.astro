---
import exp from '../data/experience.json'
import meta from '../data/sync-meta.json'
import { site } from '../data/site'
const now = exp[0]; const role = now.roles[0]
const rest = exp.slice(1)
const yr = (s: string | null) => (s ? s.slice(-4) : 'Now')
const synced = new Date(meta.syncedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
const nodes = ['GCS', 'Airflow', 'Dataform', 'BigQuery', 'Looker']
---
<section id="work" class="scroll-mt-20 bg-mist px-6 pt-24 pb-24 md:px-12 md:pt-32 md:pb-20">
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 data-reveal class="s-head"><b>Work experience.</b> From frontend at scale to data platforms on GCP, synced straight from LinkedIn.</h2>
      <a data-reveal href={site.socials[0].href} target="_blank" rel="noopener" class="s-btn bg-navy text-white hover:bg-[#22305a]">LinkedIn profile <span class="chev">›</span></a>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      <!-- current role, big card with a live pipeline diagram -->
      <article data-reveal class="s-card relative overflow-hidden p-7 md:col-span-2 md:p-9">
        <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 size-72 rounded-full bg-cyan/40 blur-3xl"></div>
        <p class="flex items-center gap-2 text-sm font-medium text-teal"><span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-teal opacity-60"></span><span class="relative inline-flex size-2 rounded-full bg-teal"></span></span>Current role</p>
        <h3 class="mt-3 text-2xl font-semibold tracking-tight text-navy md:text-3xl">{role.title} at {now.company}</h3>
        <p class="mt-1 text-sm text-slate">{role.start} to present, {role.duration}{role.location && `, ${role.location}`}</p>
        {role.highlights.length > 0 && <p class="mt-5 max-w-[60ch] leading-relaxed text-slate">{role.highlights.join(' ')}</p>}
        <div class="mt-8 rounded-xl border border-edge bg-white/70 p-4 backdrop-blur" aria-label="Example pipeline">
          <p class="mb-3 text-xs font-medium text-slate">Typical pipeline</p>
          <div class="flex items-center gap-2 overflow-x-auto">
            {nodes.map((n, i) => (
              <>
                <span class="shrink-0 rounded-lg border border-edge bg-white px-3 py-1.5 text-xs font-medium text-navy shadow-sm">{n}</span>
                {i < nodes.length - 1 && <span class="flow min-w-6 flex-1" style={`--fd:${i * 0.45}s`}></span>}
              </>
            ))}
          </div>
        </div>
      </article>

      <aside data-reveal class="s-card flex flex-col p-7">
        <p class="text-sm font-medium text-slate">Day to day</p>
        <ul class="mt-4 space-y-3 text-sm text-navy">
          {['Airflow on Cloud Composer & Docker', 'BigQuery modelling with Dataform', 'Batch ingestion from APIs & databases', 'Terraform & CI/CD', 'Monitoring and alerting'].map(t => (
            <li class="flex gap-2.5"><span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-blue"></span>{t}</li>
          ))}
        </ul>
        <p class="mt-auto pt-6 text-xs text-slate">Synced from LinkedIn on {synced}</p>
      </aside>
    </div>

    <!-- full history -->
    <div data-reveal class="s-card mt-5 divide-y divide-edge">
      {rest.map((c) => {
        const first = c.roles.at(-1)!; const last = c.roles[0]
        const range = yr(first.start) === yr(last.end) ? yr(first.start) : `${yr(first.start)} – ${yr(last.end)}`
        return (
          <details class="group">
            <summary class="grid cursor-pointer list-none grid-cols-12 items-center gap-3 px-6 py-5 transition-colors hover:bg-mist md:px-8 [&::-webkit-details-marker]:hidden">
              <span class="col-span-12 text-lg font-semibold text-navy md:col-span-5">{c.company}</span>
              <span class="col-span-8 text-sm text-slate md:col-span-4">{last.title}{c.roles.length > 1 && ` +${c.roles.length - 1}`}</span>
              <span class="col-span-3 text-right text-sm text-slate tabular-nums md:col-span-2">{range}</span>
              <span class="col-span-1 justify-self-end text-blue transition-transform group-open:rotate-90">›</span>
            </summary>
            <div class="space-y-5 px-6 pb-6 md:px-8">
              {c.roles.map((r) => (
                <div class="md:pl-[41.66%]">
                  <p class="font-medium text-navy">{r.title}{r.type && <span class="font-normal text-slate">, {r.type.toLowerCase()}</span>}</p>
                  <p class="text-xs text-slate">{r.start} – {r.end ?? 'Present'}, {r.duration}</p>
                  {r.highlights.length > 0 && <div class="mt-2 max-w-[62ch] space-y-1.5 text-sm leading-relaxed text-slate">{r.highlights.map(h => <p>{h}</p>)}</div>}
                </div>
              ))}
            </div>
          </details>
        )
      })}
    </div>
  </div>
</section>
